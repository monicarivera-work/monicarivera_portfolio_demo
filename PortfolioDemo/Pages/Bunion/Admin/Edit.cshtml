@page "/Bunion/Admin/Edit/{id:guid}"
@model EditModel
@{
    ViewData["Title"] = "Edit Article";
    Layout = "_BunionLayout";
}

<!-- Admin bar -->
<div class="bunion-admin-bar">
  <div class="container d-flex justify-content-between align-items-center">
    <span><i class="fas fa-edit me-2"></i>Edit Article</span>
    <div>
      <a href="/Bunion/Admin/Dashboard">← Dashboard</a>
      <a href="/Bunion/Admin/Logout">Sign Out</a>
    </div>
  </div>
</div>

<div class="container py-4">
  <div class="bunion-admin-panel">
    <h1 class="bunion-admin-title">Edit Article</h1>

    @if (Model.Article == null)
    {
      <div class="bunion-alert bunion-alert-error">Article not found.</div>
      <a href="/Bunion/Admin/Dashboard" class="bunion-btn-secondary">← Back to Dashboard</a>
    }
    else
    {
      <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Article.Id" />

        <div class="row">
          <div class="col-md-8">
            <div class="bunion-form-group">
              <label class="bunion-form-label" for="title">Headline *</label>
              <input type="text" id="title" name="title" class="bunion-form-control"
                     value="@Model.Article.Title" required maxlength="200" />
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-label" for="subtitle">Subheadline</label>
              <input type="text" id="subtitle" name="subtitle" class="bunion-form-control"
                     value="@Model.Article.Subtitle" maxlength="400" />
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-label" for="body">Article Body (HTML) *</label>
              <textarea id="body" name="body" class="bunion-form-control bunion-textarea"
                        required>@Model.Article.Body</textarea>
              <p class="bunion-form-hint">
                HTML supported: <code>&lt;p&gt;</code>, <code>&lt;strong&gt;</code>, <code>&lt;em&gt;</code>,
                <code>&lt;a href="..."&gt;</code>, <code>&lt;blockquote class="bunion-pullquote"&gt;</code>, etc.
              </p>
            </div>
          </div>

          <div class="col-md-4">
            <div class="bunion-form-group">
              <label class="bunion-form-label" for="category">Section *</label>
              <select id="category" name="category" class="bunion-form-control" required>
                @foreach (var cat in BunionCategories.All)
                {
                  if (Model.Article.Category == cat)
                  {
                    <option value="@cat" selected="selected">@cat</option>
                  }
                  else
                  {
                    <option value="@cat">@cat</option>
                  }
                }
              </select>
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-label" for="author">Author</label>
              <input type="text" id="author" name="author" class="bunion-form-control"
                     value="@Model.Article.Author" maxlength="100" />
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-label" for="imageUrl">Image URL</label>
              <input type="url" id="imageUrl" name="imageUrl" class="bunion-form-control"
                     value="@Model.Article.ImageUrl" />
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-label" for="imageAlt">Image Caption / Alt Text</label>
              <input type="text" id="imageAlt" name="imageAlt" class="bunion-form-control"
                     value="@Model.Article.ImageAlt" maxlength="300" />
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-label" for="tags">Tags</label>
              <input type="text" id="tags" name="tags" class="bunion-form-control"
                     value="@string.Join(", ", Model.Article.Tags)"
                     placeholder="politics, satire, area man" />
              <p class="bunion-form-hint">Comma-separated.</p>
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-check">
                <input type="checkbox" name="isFeatured" value="true"
                       @(Model.Article.IsFeatured ? "checked" : "") />
                <span>Featured</span>
              </label>
            </div>

            <div class="bunion-form-group">
              <label class="bunion-form-check">
                <input type="checkbox" name="isPublished" value="true"
                       @(Model.Article.IsPublished ? "checked" : "") />
                <span>Published</span>
              </label>
            </div>

            <div class="bunion-form-group" style="margin-top:24px;">
              <button type="submit" class="bunion-btn-primary" style="width:100%;">
                <i class="fas fa-save me-1"></i>Save Changes
              </button>
              <a href="/Bunion/Admin/Dashboard" class="bunion-btn-secondary"
                 style="width:100%; display:block; text-align:center; margin-top:8px;">
                Cancel
              </a>
            </div>

            <div style="margin-top:16px; padding-top:12px; border-top:1px solid #eee;">
              <p style="font-size:0.75rem; color:var(--bunion-mid); font-family:var(--bunion-sans);">
                Slug: <code>@Model.Article.Slug</code><br/>
                Published: @Model.Article.PublishDate.ToString("MMM d, yyyy")
              </p>
            </div>
          </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
          <div class="bunion-alert bunion-alert-error" role="alert">@Model.ErrorMessage</div>
        }

      </form>
    }
  </div>
</div>
