            color: '#8080ff',
            buff: { name: 'Shielded', icon: '🛡️', dur: 6, id: 'shield' },
        },
    ];

    const ENEMY_TYPES = [
        { name: 'Undead Warrior',   icon: '💀', level: 58, hp: 1000, dmgMin: 60, dmgMax: 110, attackSpeed: 2.0, isBoss: false, xp: 100 },
        { name: 'Plague Bat',        icon: '🦇', level: 56, hp: 700,  dmgMin: 45, dmgMax: 85,  attackSpeed: 1.4, isBoss: false, xp: 80 },
        { name: 'Crypt Fiend',       icon: '🕷️', level: 60, hp: 1300, dmgMin: 80, dmgMax: 140, attackSpeed: 2.2, isBoss: false, xp: 150 },
        { name: 'Frost Wyrm',        icon: '🐉', level: 62, hp: 2000, dmgMin: 100, dmgMax: 180, attackSpeed: 3.0, isBoss: false, xp: 220 },
        { name: 'Banshee Queen',     icon: '👻', level: 63, hp: 1600, dmgMin: 90, dmgMax: 165, attackSpeed: 1.8, isBoss: false, xp: 200 },
        { name: 'Fel Orc Brute',     icon: '👹', level: 65, hp: 2200, dmgMin: 120, dmgMax: 200, attackSpeed: 2.5, isBoss: false, xp: 280 },
        { name: 'Naxxramas Sentinel',icon: '🤖', level: 68, hp: 2800, dmgMin: 140, dmgMax: 230, attackSpeed: 2.8, isBoss: false, xp: 350 },
        { name: '☠️ LICH KING',      icon: '💎', level: 80, hp: 5000, dmgMin: 200, dmgMax: 380, attackSpeed: 3.5, isBoss: true,  xp: 1000 },
    ];

    const WAVE_CONFIGS = [
        { name: 'The Plaguelands',  enemies: [0, 1],       bg: 'rgba(139,69,19,0.06)' },
        { name: 'Naxxramas Entry',  enemies: [1, 2, 2],    bg: 'rgba(80,0,120,0.06)' },
        { name: 'Icecrown Spire',   enemies: [2, 3],       bg: 'rgba(0,60,120,0.06)' },
        { name: 'Banshee Hollow',   enemies: [4, 4, 5],    bg: 'rgba(100,0,80,0.06)' },
        { name: 'Fel Citadel',      enemies: [5, 6],       bg: 'rgba(120,60,0,0.06)' },
        { name: 'Frozen Throne',    enemies: [7],          bg: 'rgba(0,80,160,0.07)' },
    ];

    /* ============================================================
       GAME STATE
    ============================================================ */
    const state = {
        running: false,
        speed: 1,
        wave: 0,
        enemyIndex: 0,
        player: null,
        enemy: null,
        abilityCooldowns: {},
        totalDmg: 0,
        totalHeal: 0,
        kills: 0,
        lastTick: 0,
        combatTimer: 0,
        floatIdCounter: 0,
        logCount: 0,
        enemyAttackTimer: 0,
        playerBuffs: [],
        enemyDebuffs: [],
        projectiles: [],
        gameOver: false,
        paused: false,
    };

    /* ============================================================
       HELPERS
    ============================================================ */
    function rng(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function clamp(val, min, max) {
        return Math.max(min, Math.min(max, val));
    }

    function formatNum(n) {
        if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
        if (n >= 1000) return (n / 1000).toFixed(1) + 'K';
        return n.toString();
    }

    function el(id) { return document.getElementById(id); }

    function now() { return performance.now(); }

    /* ============================================================
       DOM HELPERS
    ============================================================ */
    function setBar(barId, textId, current, max, type) {
        const pct = clamp((current / max) * 100, 0, 100);
        const bar = el(barId);
        const txt = el(textId);
        if (!bar || !txt) return;
        bar.style.width = pct + '%';
        txt.textContent = Math.max(0, Math.floor(current)) + ' / ' + Math.floor(max);

        if (type === 'hp') {
            bar.className = 'bar-fill hp';
            if (pct <= 30) bar.classList.add('low');
            else if (pct <= 60) bar.classList.add('medium');
        }
    }

    function spawnFloatNum(targetEl, text, cssClass, dx) {
        const container = el('battleArena');
        if (!container) return;
        const rect = targetEl.getBoundingClientRect();
        const arenaRect = container.getBoundingClientRect();
        const div = document.createElement('div');
        div.className = 'float-num ' + cssClass;
        div.textContent = text;
        div.style.left = (rect.left - arenaRect.left + rect.width / 2 - 20) + 'px';
        div.style.top = (rect.top - arenaRect.top) + 'px';
        div.style.setProperty('--dx', (dx || rng(-25, 25)) + 'px');
        div.style.position = 'absolute';
        container.style.position = 'relative';
        container.appendChild(div);
        div.addEventListener('animationend', () => div.remove());
    }

    function addLog(text, cssClass) {
        const log = el('combatLog');
        if (!log) return;
        const d = new Date();
        const time = d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0') + ':' + d.getSeconds().toString().padStart(2, '0');
        const entry = document.createElement('div');
        entry.className = 'log-entry ' + (cssClass || '');
        const ts = document.createElement('span');
        ts.className = 'time';
        ts.textContent = time;
        entry.appendChild(ts);
        entry.appendChild(document.createTextNode(text));
        log.appendChild(entry);
        // Keep log manageable
        state.logCount++;
        if (state.logCount > 200) {
            log.removeChild(log.firstChild);
            state.logCount--;
        }
        log.scrollTop = log.scrollHeight;
    }

    function animateSprite(id, cls, duration) {
        const sprite = el(id);
        if (!sprite) return;
        sprite.classList.add(cls);
        setTimeout(() => sprite.classList.remove(cls), duration || 400);
    }

    function launchProjectile(emoji, fromId, toId, duration) {
        const arena = el('battleArena');
        const from = el(fromId);
        const to = el(toId);
        if (!arena || !from || !to) return;
        const fromRect = from.getBoundingClientRect();
        const toRect = to.getBoundingClientRect();
        const arenaRect = arena.getBoundingClientRect();
        const startX = fromRect.left - arenaRect.left + fromRect.width / 2;
        const startY = fromRect.top - arenaRect.top + fromRect.height / 2;
        const travel = toRect.left - fromRect.left;
        const p = document.createElement('div');
        p.className = 'projectile';
        p.textContent = emoji;
        p.style.left = startX + 'px';
        p.style.top = startY + 'px';
        p.style.setProperty('--travel', travel + 'px');
        p.style.setProperty('--duration', (duration || 400) + 'ms');
        arena.style.position = 'relative';
        arena.appendChild(p);
        p.addEventListener('animationend', () => p.remove());
    }

    /* ============================================================
       BUFF / DEBUFF SYSTEM
    ============================================================ */
    function renderBuffs(buffs, elId) {
        const container = el(elId);
        if (!container) return;
        container.innerHTML = '';
        buffs.forEach(b => {
            const d = document.createElement('div');
            d.className = 'buff-icon';
            d.title = b.name;
            d.textContent = b.icon;
            const dur = document.createElement('span');
            dur.className = 'buff-dur';
            dur.textContent = Math.ceil(b.remaining) + 's';
            d.appendChild(dur);
            container.appendChild(d);
        });
    }

    function tickBuffs(buffs, dt) {
        for (let i = buffs.length - 1; i >= 0; i--) {
            buffs[i].remaining -= dt;
            if (buffs[i].remaining <= 0) {
                buffs.splice(i, 1);
            }
        }
    }

    function hasBuff(buffs, id) {
        return buffs.some(b => b.id === id);
    }

    function addBuff(buffs, buffDef) {
        const existing = buffs.find(b => b.id === buffDef.id);
        if (existing) {
            existing.remaining = buffDef.dur;
        } else {
            buffs.push({ ...buffDef, remaining: buffDef.dur });
        }
    }

    /* ============================================================
       ACTION BAR RENDERING
    ============================================================ */
    function renderActionBar() {
        const bar = el('actionBar');
        if (!bar) return;
        bar.innerHTML = '';
        ABILITIES.forEach((ab, i) => {
            const btn = document.createElement('div');
            btn.className = 'ability-btn';
            btn.id = 'ab_' + ab.id;
            btn.innerHTML = `
                <span class="ability-key">${ab.key}</span>
                <span class="ability-icon">${ab.icon}</span>
                <span class="ability-name">${ab.name}</span>
                <div class="ability-cd-overlay" id="cd_${ab.id}"></div>
                <div class="ability-tooltip">
                    <div class="tt-name">${ab.icon} ${ab.name}</div>
                    <div class="tt-desc">${ab.desc}</div>
                    <div class="tt-cd">Cooldown: ${ab.cd.toFixed(1)}s${ab.manaCost ? ' · Mana: ' + ab.manaCost : ''}</div>
                </div>
            `;
            bar.appendChild(btn);
        });
    }

    function updateActionBar(dt) {
        ABILITIES.forEach(ab => {
            const cd = state.abilityCooldowns[ab.id] || 0;
        const overlay = el('cd_' + ab.id);
        const btn = el('ab_' + ab.id);
        if (!overlay || !btn) return;

        if (cd > 0) {
            const pct = cd / ab.cd;
            // Sweep: draw a radial cull based on cd percentage
            overlay.innerHTML = `<div class="cd-sweep" style="clip-path:${getSweepClipPath(pct)}"></div><span class="cd-text">${cd.toFixed(1)}</span>`;
            btn.classList.remove('ready', 'active');
        } else {
            overlay.innerHTML = '';
            btn.classList.add('ready');
        }
        });
    }

    function getSweepClipPath(pct) {
        // Build clock-sweep clip-path polygon from pct (0=empty, 1=full coverage)
        if (pct <= 0) return 'none';
        if (pct >= 1) return 'polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 50% 0%)';
        const angle = pct * 360;
        const rad = (angle - 90) * Math.PI / 180;
        const ex = 50 + 60 * Math.cos(rad);
        const ey = 50 + 60 * Math.sin(rad);
        const points = ['50% 50%', '50% 0%'];
        // Add corners as needed for the sweep
        const corners = [
            [100, 0], [100, 100], [0, 100], [0, 0]
        ];
        let covered = 0;
        for (let i = 0; i < corners.length; i++) {
            const cornerAngle = [45, 135, 225, 315][i];
            if (angle > cornerAngle) {
                points.push(corners[i][0] + '% ' + corners[i][1] + '%');
            }
        }
        points.push(clamp(ex, 0, 100).toFixed(1) + '% ' + clamp(ey, 0, 100).toFixed(1) + '%');
        return 'polygon(' + points.join(', ') + ')';
    }

    function flashAbility(abId) {
        const btn = el('ab_' + abId);
        if (!btn) return;
        btn.classList.add('active');
        setTimeout(() => btn.classList.remove('active'), 350);
    }

    /* ============================================================
       ENEMY SPAWNING
    ============================================================ */
    function getWaveConfig() {
        const waveIdx = clamp(state.wave - 1, 0, WAVE_CONFIGS.length - 1);
        return WAVE_CONFIGS[waveIdx];
    }

    function spawnEnemy() {
        const waveConf = getWaveConfig();
        const enemyList = waveConf.enemies;
        const idx = enemyList[state.enemyIndex % enemyList.length];
        const def = ENEMY_TYPES[idx];

        // Scale by wave
        const waveMult = 1 + (state.wave - 1) * 0.25;
        state.enemy = {
            name: def.name,
            icon: def.icon,
            level: def.level,
            hp: Math.floor(def.hp * waveMult),
            maxHp: Math.floor(def.hp * waveMult),
            dmgMin: Math.floor(def.dmgMin * waveMult),
            dmgMax: Math.floor(def.dmgMax * waveMult),
            attackSpeed: def.attackSpeed,
            isBoss: def.isBoss,
            xp: def.xp,
        };
        state.enemyAttackTimer = state.enemy.attackSpeed;

        // Update enemy UI
        el('enemyName').textContent = def.name;
        el('enemyLevel').textContent = 'LV ' + def.level;
        el('enemyPortrait').textContent = def.icon;
        el('enemySprite').textContent = def.icon;
        el('enemySprite').className = 'enemy-sprite' + (def.isBoss ? ' boss' : '');
        el('enemyPortrait').classList.remove('dead');
        el('enemyBuffs').innerHTML = '';

        setBar('enemyHpBar', 'enemyHpText', state.enemy.hp, state.enemy.maxHp, 'hp');
        addLog('⚔️ ' + def.name + ' appeared! HP: ' + state.enemy.maxHp, 'system');
    }

    /* ============================================================
       AI DECISION MAKING
    ============================================================ */
    function pickAbility() {
        const p = state.player;
        const e = state.enemy;
        const hpPct = p.hp / p.maxHp;
        const mana = p.mana;
        const cds = state.abilityCooldowns;

        // Priority: heal if low health, shield if very low, arcane/fire/frost for damage, auto-attack fallback
        const abilityOrder = [];

        // Use shield if health < 25% and no shield up
        if (hpPct < 0.25 && !hasBuff(state.playerBuffs, 'shield') && !(cds['shield'] > 0) && mana >= 80) {
            abilityOrder.push('shield');
        }

        // Heal if health < 50%
        if (hpPct < 0.50 && !(cds['heal'] > 0) && mana >= 150) {
            abilityOrder.push('heal');
        }

        // Arcane Blast if off cd and enough mana
        if (!(cds['arcaneblast'] > 0) && mana >= 200) {
            abilityOrder.push('arcaneblast');
        }

        // Fireball
        if (!(cds['fireball'] > 0) && mana >= 120) {
            abilityOrder.push('fireball');
        }

        // Frostbolt
        if (!(cds['frostbolt'] > 0) && mana >= 90) {
            abilityOrder.push('frostbolt');
        }

        // Auto-attack always fallback
        abilityOrder.push('autoattack');

        return abilityOrder[0] || 'autoattack';
    }

    /* ============================================================
       COMBAT EXECUTION
    ============================================================ */
    function useAbility(abId) {
        const ab = ABILITIES.find(a => a.id === abId);
        if (!ab || !state.enemy || !state.running) return;

        const p = state.player;
        const e = state.enemy;

        // Deduct mana
        p.mana = Math.max(0, p.mana - ab.manaCost);

        // Set cooldown
        state.abilityCooldowns[ab.id] = ab.cd;

        // Flash button
        flashAbility(ab.id);

        // Heal ability
        if (ab.type === 'heal') {
            const healAmt = rng(ab.healMin, ab.healMax);
            const isCrit = Math.random() < ab.critChance;
            const actual = isCrit ? Math.floor(healAmt * 1.5) : healAmt;
            p.hp = Math.min(p.maxHp, p.hp + actual);
            state.totalHeal += actual;
            el('statHeal').textContent = formatNum(state.totalHeal);

            animateSprite('heroSprite', 'casting', 600);
            spawnFloatNum(el('heroSprite'), (isCrit ? '✨ CRIT +' : '+') + actual, 'heal');
            addLog((isCrit ? '✨ CRITICAL HEAL! ' : '') + 'You cast Healing Wave, restoring ' + actual + ' HP.', isCrit ? 'crit' : 'heal');

            if (ab.buff) addBuff(state.playerBuffs, ab.buff);
            return;
        }

        // Shield ability
        if (ab.type === 'shield') {
            addBuff(state.playerBuffs, ab.buff);
            animateSprite('heroSprite', 'casting', 600);
            spawnFloatNum(el('heroSprite'), '🛡️ SHIELDED!', 'absorb');
            addLog('🛡️ You cast Mana Shield. Incoming damage will be reduced!', 'buff');
            return;
        }

        // Damage abilities
        const isCrit = Math.random() < ab.critChance;
        const isMiss = Math.random() < 0.05; // 5% miss chance
        let dmgAmt = 0;

        if (isMiss) {
            addLog('You used ' + ab.name + ' but it missed!', 'miss');
            spawnFloatNum(el('enemySprite'), 'MISS', 'miss');
        } else {
            dmgAmt = rng(ab.dmgMin, ab.dmgMax);
            if (isCrit) dmgAmt = Math.floor(dmgAmt * 2);
            state.totalDmg += dmgAmt;
            el('statDmg').textContent = formatNum(state.totalDmg);

            e.hp = Math.max(0, e.hp - dmgAmt);

            // Sprite animations
            if (ab.type === 'melee') {
                animateSprite('heroSprite', 'attacking', 400);
            } else {
                animateSprite('heroSprite', 'casting', 600);
                if (ab.projectile) {
                    launchProjectile(ab.projectile, 'heroSprite', 'enemySprite', 350);
                }
            }

            setTimeout(() => {
                animateSprite('enemySprite', 'hurt', 300);
                spawnFloatNum(el('enemySprite'), (isCrit ? '💥 ' : '') + dmgAmt, isCrit ? 'crit' : 'dmg', 0);
            }, ab.projectile ? 300 : 0);

            // Debuff
            if (ab.debuff && e.hp > 0) {
                addBuff(state.enemyDebuffs, ab.debuff);
            }

            const logText = isCrit
                ? `💥 CRITICAL STRIKE! ${ab.name} critically hit ${e.name} for ${dmgAmt} damage!`
                : `${ab.icon} Your ${ab.name} hit ${e.name} for ${dmgAmt} damage.`;
            addLog(logText, isCrit ? 'crit' : 'ability');
        }

        // Update enemy bars
        setBar('enemyHpBar', 'enemyHpText', e.hp, e.maxHp, 'hp');

        // Check enemy death
        if (e.hp <= 0) {
            handleEnemyDeath();
        }
    }

    function handleEnemyDeath() {
        state.kills++;
        el('statKills').textContent = state.kills;
        animateSprite('enemySprite', 'dead', 500);
        el('enemyPortrait').classList.add('dead');

        addLog('💀 ' + state.enemy.name + ' has been slain!', 'death');

        state.running = false;
        state.enemy = null;

        // Regen some mana on kill
        state.player.mana = Math.min(state.player.maxMana, state.player.mana + 150);

        setTimeout(() => {
            state.enemyIndex++;
            const waveConf = getWaveConfig();
            if (state.enemyIndex >= waveConf.enemies.length) {
                // Wave complete
                state.enemyIndex = 0;
                state.wave++;
                el('statWave').textContent = state.wave;

                if (state.wave > WAVE_CONFIGS.length) {
                    // Victory!
                    showOverlay(true);
                    return;
                }

                const nextWave = getWaveConfig();
                el('waveIndicator').textContent = '⚔️ WAVE ' + state.wave + ' — ' + nextWave.name;
                addLog('🏆 WAVE ' + (state.wave - 1) + ' COMPLETE! Preparing Wave ' + state.wave + '...', 'system');

                setTimeout(() => {
                    spawnEnemy();
                    state.running = true;
                }, 2000);
            } else {
                // Next enemy in wave
                spawnEnemy();
                state.running = true;
            }
        }, 800);
    }

    function enemyAttack() {
        const p = state.player;
        const e = state.enemy;

        const isCrit = Math.random() < 0.10;
        const isMiss = Math.random() < 0.08;

        if (isMiss) {
            addLog(e.name + ' attacked but missed!', 'miss');
            spawnFloatNum(el('heroSprite'), 'MISS', 'miss');
            return;
        }

        let dmg = rng(e.dmgMin, e.dmgMax);
        if (isCrit) dmg = Math.floor(dmg * 1.8);

        // Check shield
        if (hasBuff(state.playerBuffs, 'shield')) {
            const absorbed = Math.floor(dmg * 0.45);
            dmg -= absorbed;
            spawnFloatNum(el('heroSprite'), '-' + absorbed + ' absorbed', 'absorb');
        }

        p.hp = Math.max(0, p.hp - dmg);

        animateSprite('enemySprite', 'attacking', 400);
        setTimeout(() => {
            animateSprite('heroSprite', 'hurt', 300);
            spawnFloatNum(el('heroSprite'), (isCrit ? '💢 ' : '') + dmg, isCrit ? 'enemy-crit' : 'enemy-dmg', 0);
        }, 250);

        addLog(
            isCrit
                ? `💢 CRITICAL! ${e.name} strikes you for ${dmg} damage!`
                : `${e.name} attacks you for ${dmg} damage.`,
            isCrit ? 'crit' : 'dmg'
        );

        setBar('playerHpBar', 'playerHpText', p.hp, p.maxHp, 'hp');

        if (p.hp <= 0) {
            handlePlayerDeath();
        }
    }

    function handlePlayerDeath() {
        state.running = false;
        el('heroSprite').textContent = '💀';
        el('playerPortrait').classList.add('dead');
        addLog('☠️ You have been slain! Press Play Again to continue.', 'death');
        setTimeout(() => showOverlay(false), 500);
    }

    /* ============================================================
       GAME LOOP
    ============================================================ */
    let rafId = null;

    function gameLoop(timestamp) {
        if (state.gameOver) return;
        rafId = requestAnimationFrame(gameLoop);

        const dt = Math.min((timestamp - state.lastTick) / 1000, 0.1) * state.speed;
        state.lastTick = timestamp;

        if (!state.running) return;

        const p = state.player;
        const e = state.enemy;
        if (!p || !e) return;

        // Tick cooldowns
        for (const key in state.abilityCooldowns) {
            state.abilityCooldowns[key] = Math.max(0, state.abilityCooldowns[key] - dt);
        }

        // Tick buffs/debuffs
        tickBuffs(state.playerBuffs, dt);
        tickBuffs(state.enemyDebuffs, dt);

        // Update action bar overlays
        updateActionBar(dt);

        // Render buffs
        renderBuffs(state.playerBuffs, 'playerBuffs');
        renderBuffs(state.enemyDebuffs, 'enemyBuffs');

        // Update mana bars
        setBar('playerManaBar', 'playerManaText', p.mana, p.maxMana, 'mana');
        setBar('playerHpBar', 'playerHpText', p.hp, p.maxHp, 'hp');

        // Mana regen
        p.mana = Math.min(p.maxMana, p.mana + dt * 15);

        // Player AI: pick and use ability
        state.combatTimer -= dt;
        if (state.combatTimer <= 0) {
            const chosenAbility = pickAbility();
            const ab = ABILITIES.find(a => a.id === chosenAbility);
            if (ab) {
                useAbility(chosenAbility);
                // Reset combat timer to that ability's cooldown (or autoattack speed)
                state.combatTimer = ab.type === 'melee' ? ab.cd : 0.15 + Math.random() * 0.2;
            } else {
                state.combatTimer = ABILITIES[0].cd; // auto-attack fallback
                useAbility('autoattack');
            }
        }

        // Enemy attack timer
        if (e && e.hp > 0) {
            state.enemyAttackTimer -= dt;
            if (state.enemyAttackTimer <= 0) {
                enemyAttack();
                state.enemyAttackTimer = e.attackSpeed;
            }
        }
    }

    /* ============================================================
       GAME SETUP / RESTART
    ============================================================ */
    function initPlayer() {
        state.player = {
            name: 'Arthas the Brave',
            icon: '🧙‍♂️',
            level: 60,
            hp: 1500,
            maxHp: 1500,
            mana: 800,
            maxMana: 800,
        };
    }

    function resetState() {
        state.running = false;
        state.wave = 1;
        state.enemyIndex = 0;
        state.enemy = null;
        state.abilityCooldowns = {};
        state.totalDmg = 0;
        state.totalHeal = 0;
        state.kills = 0;
        state.combatTimer = 0;
        state.enemyAttackTimer = 0;
        state.playerBuffs = [];
        state.enemyDebuffs = [];
        state.gameOver = false;
        state.lastTick = performance.now();
    }

    function startGame() {
        resetState();
        initPlayer();

        // Reset UI
        el('heroSprite').textContent = '🧙‍♂️';
        el('playerPortrait').textContent = '🧙‍♂️';
        el('playerPortrait').classList.remove('dead');
        el('statWave').textContent = '1';
        el('statDmg').textContent = '0';
        el('statKills').textContent = '0';
        el('statHeal').textContent = '0';
        el('combatLog').innerHTML = '';
        state.logCount = 0;
        el('playerBuffs').innerHTML = '';
        el('enemyBuffs').innerHTML = '';

        setBar('playerHpBar', 'playerHpText', state.player.hp, state.player.maxHp, 'hp');
        setBar('playerManaBar', 'playerManaText', state.player.mana, state.player.maxMana, 'mana');

        el('waveIndicator').textContent = '⚔️ WAVE 1 — ' + WAVE_CONFIGS[0].name;

        renderActionBar();
        spawnEnemy();

        addLog('⚔️ Combat has begun! Your hero fights automatically.', 'system');
        addLog('💡 Watch the action bar as abilities are cast automatically.', 'system');

        state.running = true;

        if (rafId) cancelAnimationFrame(rafId);
        state.lastTick = performance.now();
        rafId = requestAnimationFrame(gameLoop);
    }

    /* ============================================================
       OVERLAY
    ============================================================ */
    function showOverlay(isVictory) {
        state.gameOver = true;
        state.running = false;

        const overlay = el('gameOverlay');
        const title = el('overlayTitle');
        const subtitle = el('overlaySubtitle');
        const statsEl = el('overlayStats');

        title.textContent = isVictory ? '🏆 VICTORY!' : '💀 DEFEAT';
        title.className = 'overlay-title ' + (isVictory ? 'victory' : 'defeat');
        subtitle.textContent = isVictory
            ? 'The Lich King has been defeated! Azeroth is saved!'
            : 'You have fallen in battle. Rise again, champion!';

        statsEl.innerHTML = `
            <div class="overlay-stat">
                <span class="overlay-stat-val">${el('statWave').textContent}</span>
                <span class="overlay-stat-label">WAVES</span>
            </div>
            <div class="overlay-stat">
                <span class="overlay-stat-val">${formatNum(state.totalDmg)}</span>
                <span class="overlay-stat-label">DAMAGE</span>
            </div>
            <div class="overlay-stat">
                <span class="overlay-stat-val">${state.kills}</span>
                <span class="overlay-stat-label">KILLS</span>
            </div>
            <div class="overlay-stat">
                <span class="overlay-stat-val">${formatNum(state.totalHeal)}</span>
                <span class="overlay-stat-label">HEALED</span>
            </div>
        `;

        overlay.classList.add('active');
    }

    /* ============================================================
       PUBLIC API
    ============================================================ */
    window.wowGame = {
        restart() {
            el('gameOverlay').classList.remove('active');
            startGame();
        },
        setSpeed(s) {
            state.speed = s;
            ['spd1', 'spd2', 'spd3'].forEach((id, i) => {
                const btn = el(id);
                if (btn) {
                    btn.style.opacity = (i + 1 === s) ? '1' : '0.5';
                    btn.style.borderColor = (i + 1 === s) ? 'var(--wow-gold)' : 'rgba(139,105,20,0.5)';
                }
            });
        },
        clearLog() {
            const log = el('combatLog');
            if (log) { log.innerHTML = ''; state.logCount = 0; }
        }
    };

    /* ============================================================
       INIT
    ============================================================ */
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            startGame();
            window.wowGame.setSpeed(1);
        });
    } else {
        startGame();
        window.wowGame.setSpeed(1);
    }

})();
</script>
