@page
@model WoWGameModel
@{
    ViewData["Title"] = "⚔️ Auto-Battle Simulator";
    ViewData["Description"] = "A World of Warcraft-inspired auto-battle simulator. Watch your hero automatically defeat waves of enemies using classic RPG abilities!";
}

<style>
    /* ============================================================
       WOW-STYLE AUTO-BATTLE SIMULATOR
       Inspired by World of Warcraft's iconic UI
    ============================================================ */

    @* Import a fantasy-style font *@
    @@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=IM+Fell+English&display=swap');

    :root {
        --wow-gold: #ffd100;
        --wow-gold-dark: #b8860b;
        --wow-gold-border: #8b6914;
        --wow-panel-bg: rgba(10, 6, 2, 0.92);
        --wow-panel-border: #3d2a0a;
        --wow-hp-full: #00c800;
        --wow-hp-low: #c80000;
        --wow-mana: #0070de;
        --wow-energy: #ffee00;
        --wow-rage: #c41e3a;
        --wow-text: #ffd100;
        --wow-text-light: #e8d5a3;
        --wow-dmg: #ff4040;
        --wow-heal: #00ff80;
        --wow-crit: #ff8c00;
        --wow-miss: #c0c0c0;
        --wow-ability: #aad4f5;
        --wow-bg-dark: #0d0805;
    }

    /* ── Page Wrapper ── */
    .wow-page {
        background: radial-gradient(ellipse at center top, #1a0d00 0%, #0d0805 50%, #050302 100%);
        min-height: 100vh;
        padding: 0;
        margin: 0;
        font-family: 'Cinzel', 'Palatino Linotype', 'Book Antiqua', serif;
        color: var(--wow-text-light);
        position: relative;
        overflow: hidden;
    }

    /* ── Background ambiance ── */
    .wow-page::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
            radial-gradient(circle at 20% 80%, rgba(139, 69, 19, 0.08) 0%, transparent 40%),
            radial-gradient(circle at 80% 20%, rgba(70, 0, 120, 0.06) 0%, transparent 40%);
        pointer-events: none;
        z-index: 0;
    }

    .wow-game-container {
        position: relative;
        z-index: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 0.75rem 2rem;
        min-height: calc(100vh - 140px);
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    /* ── Title Bar ── */
    .wow-title-bar {
        text-align: center;
        padding: 0.5rem 0 0.25rem;
    }

    .wow-title-bar h1 {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: clamp(1.3rem, 3vw, 2rem);
        color: var(--wow-gold);
        text-shadow: 0 0 20px rgba(255, 209, 0, 0.5), 0 2px 4px #000;
        letter-spacing: 0.05em;
        margin: 0;
    }

    .wow-title-bar p {
        font-family: 'IM Fell English', serif;
        color: #c8a86c;
        font-size: 0.8rem;
        margin: 0.15rem 0 0;
        letter-spacing: 0.1em;
    }

    /* ── WoW Panel mixin ── */
    .wow-panel {
        background: var(--wow-panel-bg);
        border: 2px solid var(--wow-gold-border);
        border-radius: 4px;
        box-shadow:
            inset 0 0 12px rgba(0, 0, 0, 0.8),
            0 0 8px rgba(139, 105, 20, 0.3),
            0 4px 16px rgba(0, 0, 0, 0.6);
        position: relative;
    }

    .wow-panel::before {
        content: '';
        position: absolute;
        inset: 1px;
        border: 1px solid rgba(255, 209, 0, 0.08);
        border-radius: 2px;
        pointer-events: none;
    }

    /* ── Top Row: Player + Battle Arena + Target ── */
    .wow-top-row {
        display: grid;
        grid-template-columns: 280px 1fr 280px;
        gap: 0.6rem;
        align-items: start;
    }

    /* ── Unit Frame ── */
    .unit-frame {
        padding: 0.5rem;
    }

    .unit-frame-inner {
        display: flex;
        gap: 0.5rem;
        align-items: flex-start;
    }

    .unit-portrait {
        width: 54px;
        height: 54px;
        border: 2px solid var(--wow-gold-border);
        border-radius: 3px;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
        background: #0a0600;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        box-shadow: inset 0 0 6px rgba(0,0,0,0.7);
    }

    .unit-portrait.dead {
        filter: grayscale(1) brightness(0.4);
    }

    .unit-portrait-overlay {
        position: absolute;
        inset: 0;
        border: 1px solid rgba(255, 209, 0, 0.15);
        border-radius: 2px;
    }

    .unit-bars {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .unit-name {
        font-family: 'Cinzel', serif;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--wow-gold);
        text-shadow: 1px 1px 2px #000;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 2px;
    }

    .unit-level-badge {
        display: inline-block;
        background: rgba(139, 105, 20, 0.5);
        border: 1px solid var(--wow-gold-border);
        border-radius: 2px;
        padding: 0 4px;
        font-size: 0.6rem;
        color: var(--wow-gold);
        margin-right: 4px;
        vertical-align: middle;
    }

    .bar-wrap {
        position: relative;
        height: 13px;
        background: rgba(0, 0, 0, 0.7);
        border: 1px solid rgba(80, 50, 0, 0.8);
        border-radius: 2px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        border-radius: 1px;
        transition: width 0.25s ease-out;
        position: relative;
    }

    .bar-fill.hp {
        background: linear-gradient(to bottom, #00e600, #00a000);
    }

    .bar-fill.hp.low {
        background: linear-gradient(to bottom, #e60000, #900000);
    }

    .bar-fill.hp.medium {
        background: linear-gradient(to bottom, #e6a000, #a06000);
    }

    .bar-fill.mana {
        background: linear-gradient(to bottom, #1a90ff, #0055aa);
    }

    .bar-fill.energy {
        background: linear-gradient(to bottom, #ffee30, #c0a000);
    }

    .bar-text {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Cinzel', serif;
        font-size: 0.55rem;
        font-weight: 600;
        color: #fff;
        text-shadow: 1px 1px 1px #000, 0 0 3px rgba(0,0,0,0.8);
        letter-spacing: 0.02em;
    }

    /* ── Battle Arena ── */
    .battle-arena {
        min-height: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0.75rem;
        position: relative;
        overflow: hidden;
    }

    .battle-scene {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        width: 100%;
        height: 140px;
        position: relative;
    }

    /* ── Ground line ── */
    .battle-ground {
        position: absolute;
        bottom: 20px;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(to right, transparent, rgba(139, 105, 20, 0.4), transparent);
    }

    /* ── Hero sprite ── */
    .hero-sprite {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.5rem;
        position: relative;
        filter: drop-shadow(0 4px 8px rgba(0,0,0,0.8));
        transition: transform 0.15s ease;
        z-index: 2;
    }

    .hero-sprite.attacking {
        animation: heroAttack 0.4s ease;
    }

    .hero-sprite.casting {
        animation: heroCast 0.6s ease infinite;
    }

    .hero-sprite.hurt {
        animation: heroHurt 0.3s ease;
    }

    @@keyframes heroAttack {
        0% { transform: translateX(0); }
        40% { transform: translateX(30px) scale(1.1); }
        100% { transform: translateX(0); }
    }

    @@keyframes heroCast {
        0%, 100% { filter: drop-shadow(0 4px 8px rgba(0,0,0,0.8)); }
        50% { filter: drop-shadow(0 4px 16px rgba(100, 180, 255, 0.8)) drop-shadow(0 0 20px rgba(100, 180, 255, 0.6)); }
    }

    @@keyframes heroHurt {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-8px); }
        75% { transform: translateX(-4px); }
    }

    /* ── Enemy sprite ── */
    .enemy-sprite {
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4.5rem;
        position: relative;
        filter: drop-shadow(0 4px 10px rgba(200, 0, 0, 0.5));
        transition: transform 0.15s ease;
        z-index: 2;
    }

    .enemy-sprite.boss {
        font-size: 5.5rem;
        filter: drop-shadow(0 4px 12px rgba(200, 0, 200, 0.6));
    }

    .enemy-sprite.attacking {
        animation: enemyAttack 0.4s ease;
    }

    .enemy-sprite.hurt {
        animation: enemyHurt 0.25s ease;
    }

    .enemy-sprite.dead {
        animation: enemyDeath 0.5s ease forwards;
    }

    @@keyframes enemyAttack {
        0% { transform: translateX(0); }
        40% { transform: translateX(-30px) scale(1.1); }
        100% { transform: translateX(0); }
    }

    @@keyframes enemyHurt {
        0%, 100% { transform: translateX(0) scale(1); }
        50% { transform: translateX(8px) scale(0.9); filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.8)); }
    }

    @@keyframes enemyDeath {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.2) rotate(10deg); opacity: 0.6; }
        100% { transform: scale(0.5) rotate(30deg) translateY(20px); opacity: 0; }
    }

    /* ── Projectile ── */
    .projectile {
        position: absolute;
        font-size: 1.4rem;
        pointer-events: none;
        z-index: 10;
        animation: projectileFly var(--duration, 0.4s) ease-out forwards;
    }

    @@keyframes projectileFly {
        0% { transform: translateX(0) scale(1); opacity: 1; }
        100% { transform: translateX(var(--travel, 200px)) scale(0.6); opacity: 0.2; }
    }

    /* ── Floating Numbers ── */
    .float-num {
        position: absolute;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        pointer-events: none;
        z-index: 20;
        animation: floatUp 1.4s ease-out forwards;
        white-space: nowrap;
        text-shadow: 1px 1px 2px #000, 0 0 6px rgba(0,0,0,0.8);
        letter-spacing: 0.02em;
    }

    .float-num.dmg { color: var(--wow-dmg); font-size: 1.1rem; }
    .float-num.crit { color: var(--wow-crit); font-size: 1.5rem; font-weight: 700; }
    .float-num.heal { color: var(--wow-heal); font-size: 1rem; }
    .float-num.miss { color: var(--wow-miss); font-size: 0.85rem; font-style: italic; }
    .float-num.absorb { color: #8080ff; font-size: 0.9rem; }
    .float-num.enemy-dmg { color: #ff8080; font-size: 1rem; }
    .float-num.enemy-crit { color: #ff3030; font-size: 1.3rem; font-weight: 700; }

    @@keyframes floatUp {
        0% { transform: translateY(0) translateX(0) scale(0.8); opacity: 0; }
        15% { opacity: 1; transform: translateY(-10px) translateX(var(--dx, 0px)) scale(1); }
        70% { opacity: 1; }
        100% { transform: translateY(-70px) translateX(var(--dx, 0px)) scale(0.9); opacity: 0; }
    }

    /* ── Wave indicator ── */
    .wave-indicator {
        position: absolute;
        top: 6px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.7);
        border: 1px solid var(--wow-gold-border);
        border-radius: 3px;
        padding: 2px 10px;
        font-family: 'Cinzel', serif;
        font-size: 0.65rem;
        color: var(--wow-gold);
        letter-spacing: 0.08em;
        text-align: center;
        white-space: nowrap;
    }

    /* ── VS indicator ── */
    .vs-badge {
        position: absolute;
        left: 50%;
        bottom: 30px;
        transform: translateX(-50%);
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 0.7rem;
        color: rgba(255, 209, 0, 0.3);
        letter-spacing: 0.2em;
    }

    /* ── Bottom Row: Combat Log + Action Bar ── */
    .wow-bottom-row {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 0.6rem;
        align-items: start;
    }

    /* ── Action Bar ── */
    .action-bar-panel {
        padding: 0.6rem 0.5rem;
    }

    .action-bar-label {
        font-family: 'Cinzel', serif;
        font-size: 0.58rem;
        color: rgba(255, 209, 0, 0.5);
        text-align: center;
        letter-spacing: 0.12em;
        margin-bottom: 0.4rem;
    }

    .action-bar {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 4px;
    }

    .ability-btn {
        aspect-ratio: 1;
        background: #1a0f00;
        border: 2px solid var(--wow-gold-border);
        border-radius: 3px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        cursor: default;
        overflow: hidden;
        box-shadow: inset 0 0 6px rgba(0,0,0,0.8);
        transition: border-color 0.15s;
    }

    .ability-btn.ready {
        border-color: rgba(255, 209, 0, 0.6);
        box-shadow: inset 0 0 6px rgba(0,0,0,0.5), 0 0 8px rgba(255, 209, 0, 0.2);
    }

    .ability-btn.active {
        border-color: #fff;
        box-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
        animation: abilityFlash 0.3s ease;
    }

    @@keyframes abilityFlash {
        0%, 100% { box-shadow: 0 0 12px rgba(255, 255, 255, 0.4); }
        50% { box-shadow: 0 0 24px rgba(255, 255, 255, 0.9); }
    }

    .ability-icon {
        font-size: 1.5rem;
        line-height: 1;
    }

    .ability-key {
        position: absolute;
        top: 1px;
        left: 3px;
        font-family: 'Cinzel', serif;
        font-size: 0.5rem;
        color: rgba(255, 255, 255, 0.7);
        text-shadow: 1px 1px 1px #000;
        line-height: 1;
    }

    .ability-name {
        font-family: 'Cinzel', serif;
        font-size: 0.42rem;
        color: rgba(255, 230, 150, 0.8);
        text-align: center;
        margin-top: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
        padding: 0 2px;
    }

    /* Cooldown sweep overlay */
    .ability-cd-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .cd-sweep {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.72);
        transform-origin: center bottom;
        clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 50% 0%);
        transition: none;
    }

    .cd-text {
        font-family: 'Cinzel', serif;
        font-size: 0.65rem;
        font-weight: 700;
        color: #fff;
        text-shadow: 1px 1px 2px #000;
        position: relative;
        z-index: 1;
    }

    /* ── Combat Log ── */
    .combat-log-panel {
        padding: 0.5rem;
    }

    .combat-log-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        border-bottom: 1px solid rgba(139, 105, 20, 0.4);
        padding-bottom: 0.3rem;
        margin-bottom: 0.3rem;
    }

    .combat-log-header span {
        font-family: 'Cinzel', serif;
        font-size: 0.62rem;
        color: var(--wow-gold);
        letter-spacing: 0.08em;
        flex: 1;
    }

    #clearLogBtn {
        background: transparent;
        border: 1px solid rgba(139, 105, 20, 0.5);
        border-radius: 2px;
        color: rgba(255, 209, 0, 0.6);
        font-family: 'Cinzel', serif;
        font-size: 0.5rem;
        padding: 1px 6px;
        cursor: pointer;
        transition: all 0.15s;
    }

    #clearLogBtn:hover {
        background: rgba(139, 105, 20, 0.3);
        color: var(--wow-gold);
    }

    .combat-log-scroll {
        height: 130px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(139, 105, 20, 0.5) transparent;
    }

    .combat-log-scroll::-webkit-scrollbar { width: 4px; }
    .combat-log-scroll::-webkit-scrollbar-thumb { background: rgba(139, 105, 20, 0.5); border-radius: 2px; }
    .combat-log-scroll::-webkit-scrollbar-track { background: transparent; }

    .log-entry {
        font-family: 'IM Fell English', 'Palatino Linotype', serif;
        font-size: 0.7rem;
        line-height: 1.5;
        padding: 0.05rem 0.1rem;
        border-bottom: 1px solid rgba(139, 105, 20, 0.1);
    }

    .log-entry .time { color: rgba(255, 209, 0, 0.4); font-size: 0.6rem; margin-right: 4px; }
    .log-entry.dmg { color: #ffaaaa; }
    .log-entry.crit { color: #ff8c00; font-weight: 600; }
    .log-entry.heal { color: #80ffb0; }
    .log-entry.ability { color: #aad4f5; }
    .log-entry.system { color: rgba(255, 209, 0, 0.7); font-style: italic; }
    .log-entry.death { color: #ff4040; font-weight: 600; }
    .log-entry.buff { color: #d4b5e8; }
    .log-entry.miss { color: #909090; }

    /* ── Status Bar ── */
    .wow-status-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.4rem 0.8rem;
    }

    .status-stat {
        text-align: center;
    }

    .status-stat-label {
        font-size: 0.55rem;
        color: rgba(255, 209, 0, 0.5);
        letter-spacing: 0.1em;
        display: block;
        margin-bottom: 1px;
    }

    .status-stat-value {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--wow-gold);
        text-shadow: 0 0 8px rgba(255, 209, 0, 0.4);
    }

    .status-divider {
        width: 1px;
        height: 28px;
        background: rgba(139, 105, 20, 0.4);
    }

    /* ── Buff/Debuff icons ── */
    .buffs-row {
        display: flex;
        gap: 3px;
        min-height: 20px;
        margin-top: 3px;
    }

    .buff-icon {
        width: 18px;
        height: 18px;
        border: 1px solid var(--wow-gold-border);
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        position: relative;
        overflow: hidden;
        background: #1a0f00;
    }

    .buff-icon .buff-dur {
        position: absolute;
        bottom: 0;
        right: 0;
        font-size: 0.4rem;
        background: rgba(0,0,0,0.8);
        color: #fff;
        padding: 0 1px;
        line-height: 1.2;
    }

    /* ── Victory / Defeat overlay ── */
    .game-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(4px);
        animation: overlayFadeIn 0.5s ease;
        display: none;
    }

    .game-overlay.active {
        display: flex;
    }

    @@keyframes overlayFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .overlay-title {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: clamp(2rem, 6vw, 4rem);
        text-shadow: 0 0 40px currentColor;
        animation: overlayPulse 2s ease infinite;
        margin-bottom: 0.5rem;
    }

    .overlay-title.victory { color: var(--wow-gold); }
    .overlay-title.defeat { color: #c82020; }

    .overlay-subtitle {
        font-family: 'IM Fell English', serif;
        color: var(--wow-text-light);
        font-size: clamp(0.85rem, 2vw, 1.1rem);
        margin-bottom: 1.5rem;
        text-align: center;
        max-width: 400px;
    }

    .overlay-stats {
        display: flex;
        gap: 2rem;
        margin-bottom: 1.5rem;
    }

    .overlay-stat {
        text-align: center;
    }

    .overlay-stat-val {
        font-family: 'Cinzel', serif;
        font-size: 1.8rem;
        color: var(--wow-gold);
        font-weight: 700;
        display: block;
    }

    .overlay-stat-label {
        font-size: 0.7rem;
        color: #a09070;
        letter-spacing: 0.1em;
    }

    @@keyframes overlayPulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.85; transform: scale(1.03); }
    }

    .overlay-btn {
        background: linear-gradient(to bottom, #c8960a, #7a5a00);
        border: 2px solid var(--wow-gold);
        border-radius: 3px;
        color: var(--wow-gold);
        font-family: 'Cinzel', serif;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.5rem 2rem;
        cursor: pointer;
        letter-spacing: 0.06em;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        box-shadow: 0 0 12px rgba(255, 209, 0, 0.3);
        transition: all 0.15s;
    }

    .overlay-btn:hover {
        background: linear-gradient(to bottom, #ffd100, #a07800);
        color: #3a2000;
        box-shadow: 0 0 20px rgba(255, 209, 0, 0.6);
    }

    /* ── Tooltip ── */
    .ability-tooltip {
        position: absolute;
        bottom: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: rgba(5, 3, 1, 0.97);
        border: 1px solid var(--wow-gold-border);
        border-radius: 3px;
