@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "Learn about Monica Rivera's background, professional strengths, and engineering philosophy.";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">@ViewData["Title"]</h1>

            <h2 class="h3 mb-3">Monica Leigh A. Rivera</h2>

            <h2 class="mt-5 mb-3">Professional Summary</h2>
            <p>
                Software Engineer II at Microsoft with deep expertise in cloud-based and distributed systems on Azure. Designs and ships production-quality C# and .NET solutions end-to-end — from requirements and architecture through deployment and operational health. Brings a "learn-it-all" mindset, a sharp eye for security and reliability, and a genuine passion for mentoring teammates and raising the engineering bar across the team.
            </p>

            <h2 class="mt-5 mb-3">Professional Strengths</h2>
            <div class="row">
                <div class="col-md-6">
                    <h3 class="h5">Engineering Ownership</h3>
                    <ul>
                        <li>End-to-end feature delivery — design, implementation, testing, and deployment</li>
                        <li>Writes clean, well-tested, production-ready code</li>
                        <li>"Learn-it-all" instead of "Know-it-all" mindset</li>
                        <li>Strong attention to detail and code quality</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h3 class="h5">Collaboration &amp; Communication</h3>
                    <ul>
                        <li>Partners closely with PMs, designers, and cross-functional teams</li>
                        <li>Leads and participates in thorough code reviews</li>
                        <li>Clearly communicates technical decisions and trade-offs</li>
                        <li>Open-minded, adaptable, and learns from feedback</li>
                    </ul>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <h3 class="h5">Security &amp; Reliability</h3>
                    <ul>
                        <li>Follows Microsoft's Security Development Lifecycle (SDL)</li>
                        <li>Engineers secure environments with network isolation and firewall/NSG configurations</li>
                        <li>Monitors service health and responds to incidents on-call</li>
                        <li>Champions Operational and Engineering Excellence metrics</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h3 class="h5">Customer Obsessed</h3>
                    <ul>
                        <li>Puts customer impact at the center of every technical decision</li>
                        <li>Translates ambiguous requirements into robust, user-focused solutions</li>
                        <li>Consistent delivery in Agile sprints with well-crafted User Stories</li>
                        <li>Easy to reach, dependable, and punctual</li>
                    </ul>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <h3 class="h5">Technical Growth &amp; Mentorship</h3>
                    <ul>
                        <li>Actively mentors junior engineers and interns</li>
                        <li>Rapidly onboards to new systems, domains, and technologies</li>
                        <li>Contributes to SOPs, runbooks, and technical documentation</li>
                        <li>Stays current with AI tooling (Copilot Agents, LLMs)</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h3 class="h5">Cloud &amp; DevOps Fluency</h3>
                    <ul>
                        <li>Expert-level Azure skills across compute, networking, and storage</li>
                        <li>Infrastructure-as-Code for repeatable, auditable deployments</li>
                        <li>CI/CD pipeline design and maintenance in Azure DevOps</li>
                        <li>Application Insights and observability for proactive monitoring</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
