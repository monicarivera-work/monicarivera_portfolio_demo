@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "Learn about Monica Rivera's background, professional strengths, and engineering philosophy.";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">@ViewData["Title"]</h1>

            <h2 class="h3 mb-3">Monica Leigh A. Rivera</h2>
            <p class="lead mb-4">
                <strong>Email:</strong> <a href="mailto:Monica.rivera4@outlook.com">Monica.rivera4@outlook.com</a>
                <strong>Email:</strong> Monica.rivera4@outlook.com
            </p>

            <h2 class="mt-5 mb-3">Professional Summary</h2>
            <p>
                Software Engineer with extensive experience in cloud-based and distributed systems. Proven technical leader skilled in mentoring, documentation, troubleshooting, and delivering robust solutions across legacy and modern platforms. Has repeatedly demonstrated a desire to improve, learn, and deliver on technical and professional skills.
            </p>

            <h2 class="mt-5 mb-3">Professional Strengths</h2>
            <div class="row">
                <div class="col-md-6">
                    <h3 class="h5">Engineering Discovery</h3>
                    <ul>
                        <li>Rapidly onboarded to new systems and domains</li>
                        <li>"Learn-it-all" instead of "Know-it-all" mindset</li>
                        <li>Attention to detail</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h3 class="h5">Culture &amp; Communication</h3>
                    <ul>
                        <li>Open-minded and adaptable</li>
                        <li>Conflict resolution capabilities</li>
                        <li>Learns from feedback</li>
                    </ul>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <h3 class="h5">Customer Obsessed</h3>
                    <ul>
                        <li>Strong desire to fulfill customer needs</li>
                        <li>Places customer first before personal goals</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h3 class="h5">Professional Hygiene</h3>
                    <ul>
                        <li>Consistent delivery in team sprints</li>
                        <li>Excellent User Story construction</li>
                        <li>Easy to reach and punctual</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
