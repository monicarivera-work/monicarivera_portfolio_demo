/* ══════════════════════════════════════════════
   UI Logic
═══════════════════════════════════════════════ */
function switchProject(id, btn) {
    // Update tabs
    document.querySelectorAll('.project-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');

    // Update diagrams
    document.querySelectorAll('.arch-diagram').forEach(d => d.classList.remove('active'));
    const target = document.getElementById('diagram-' + id);
    if (target) target.classList.add('active');
}

function openDetail(id) {
    const d = componentData[id];
    if (!d) return;

    document.getElementById('detailIcon').textContent = d.icon;
    document.getElementById('detailCategory').textContent = d.category;
    document.getElementById('detailTitle').textContent = d.title;

    // Tech pills
    const techEl = document.getElementById('detailTech');
    techEl.innerHTML = '';
    d.tech.forEach(t => {
        const pill = document.createElement('span');
        pill.className = 'tech-pill';
        pill.textContent = t;
        techEl.appendChild(pill);
    });

    document.getElementById('detailWhy').textContent = d.why;
    document.getElementById('detailStory').innerHTML = d.story;

    // Links
    const linksSection = document.getElementById('detailLinksSection');
    const linksEl = document.getElementById('detailLinks');
    if (d.links && d.links.length > 0) {
        linksEl.innerHTML = '';
        d.links.forEach(l => {
            const a = document.createElement('a');
            a.href = l.url;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            a.className = 'detail-link me-3';
            a.innerHTML = '<i class="fas fa-external-link-alt"></i> ' + l.label;
            linksEl.appendChild(a);
        });
        linksSection.style.display = '';
    } else {
        linksSection.style.display = 'none';
    }

    const overlay = document.getElementById('detailOverlay');
    overlay.classList.add('open');
    overlay.querySelector('.detail-close').focus();
    document.body.style.overflow = 'hidden';
}

function closeDetail() {
    document.getElementById('detailOverlay').classList.remove('open');
    document.body.style.overflow = '';
}

function closeDetailOnBackdrop(e) {
    if (e.target === document.getElementById('detailOverlay')) {
        closeDetail();
    }
}

function keyDetail(e, id) {
    if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openDetail(id);
    }
}

// Close on Escape key
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeDetail();
});
</script>
