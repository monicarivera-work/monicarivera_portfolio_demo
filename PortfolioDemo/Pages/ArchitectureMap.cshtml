@page
@model ArchitectureMapModel
@{
    ViewData["Title"] = "Architecture Map";
    ViewData["Description"] = "Interactive architecture map of Monica Rivera's engineering projects — Azure Functions, SQL, hybrid connectivity, queues, and more.";
}

<style>
    /* ── Page Layout ── */
    .arch-hero {
        text-align: center;
        padding: 3rem 1rem 1.5rem;
    }

    .arch-hero h1 {
        font-size: 2.6rem;
        margin-bottom: 0.75rem;
    }

    .arch-hero p {
        color: var(--text-light, #8a8a9e);
        font-size: 1.05rem;
        max-width: 680px;
        margin: 0 auto 0.5rem;
    }

    /* ── Project Selector ── */
    .project-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .project-tab {
        background: rgba(255, 255, 255, 0.65);
        border: 2px solid rgba(212, 181, 232, 0.45);
        border-radius: 50px;
        padding: 8px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-dark, #5a5a6e);
        cursor: pointer;
        transition: all 0.25s ease;
        font-family: 'Lato', sans-serif;
        backdrop-filter: blur(6px);
    }

    .project-tab:hover,
    .project-tab.active {
        background: linear-gradient(135deg, rgba(212, 181, 232, 0.6), rgba(245, 201, 212, 0.6));
        border-color: rgba(212, 181, 232, 0.85);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(212, 181, 232, 0.3);
    }

    /* ── Diagram Canvas ── */
    .diagram-wrapper {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(12px);
        border: 2px solid rgba(212, 181, 232, 0.3);
        border-radius: 20px;
        padding: 2rem 1rem;
        box-shadow: 0 8px 32px rgba(212, 181, 232, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        min-height: 480px;
        position: relative;
        overflow-x: auto;
    }

    /* ── Architecture Diagram ── */
    .arch-diagram {
        display: none;
        animation: fadeInUp 0.4s ease-out;
    }

    .arch-diagram.active {
        display: block;
    }

    .arch-svg {
        width: 100%;
        max-width: 820px;
        display: block;
        margin: 0 auto;
        overflow: visible;
    }

    /* ── Node Styles ── */
    .arch-node {
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .arch-node:hover .node-box {
        filter: drop-shadow(0 0 12px rgba(212, 181, 232, 0.7));
        transform: translateY(-3px);
    }

    .arch-node:focus .node-box {
        outline: 3px solid #d4b5e8;
        outline-offset: 3px;
    }

    .node-box {
        transition: transform 0.25s ease, filter 0.25s ease;
        transform-origin: center;
    }

    .node-label {
        font-family: 'Lato', sans-serif;
        font-weight: 700;
        font-size: 13px;
        fill: #5a5a6e;
        pointer-events: none;
        dominant-baseline: central;
        text-anchor: middle;
    }

    .node-icon {
        font-size: 20px;
        pointer-events: none;
        dominant-baseline: central;
        text-anchor: middle;
    }

    .node-sublabel {
        font-family: 'Lato', sans-serif;
        font-size: 10px;
        fill: #8a8a9e;
        pointer-events: none;
        dominant-baseline: central;
        text-anchor: middle;
    }

    /* ── Connector Lines ── */
    .arch-connector {
        stroke-width: 2;
        fill: none;
        opacity: 0.6;
        marker-end: url(#arrowhead);
    }

    .connector-label {
        font-family: 'Lato', sans-serif;
        font-size: 10px;
        fill: #8a8a9e;
        text-anchor: middle;
    }

    /* ── Legend ── */
    .arch-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1.5rem;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8rem;
        color: var(--text-light, #8a8a9e);
    }

    .legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        flex-shrink: 0;
    }

    /* ── Hint ── */
    .click-hint {
        text-align: center;
        font-size: 0.82rem;
        color: var(--text-light, #8a8a9e);
        margin-top: 1rem;
        font-style: italic;
    }

    /* ── Detail Panel (slide-in) ── */
    .detail-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(90, 90, 110, 0.25);
        backdrop-filter: blur(3px);
        z-index: 1040;
        animation: fadeIn 0.2s ease;
    }

    .detail-overlay.open {
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .detail-panel {
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(20px);
        border-radius: 24px 24px 0 0;
        padding: 2rem;
        width: 100%;
        max-width: 680px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 -8px 40px rgba(212, 181, 232, 0.3);
        animation: slideUp 0.3s ease;
        position: relative;
    }

    @@media (min-width: 768px) {
        .detail-overlay.open {
            align-items: center;
        }

        .detail-panel {
            border-radius: 24px;
            max-height: 80vh;
            animation: popIn 0.3s ease;
        }
    }

    @@keyframes slideUp {
        from { transform: translateY(100%); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
    }

    @@keyframes popIn {
        from { transform: scale(0.92); opacity: 0; }
        to   { transform: scale(1);    opacity: 1; }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .detail-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(212, 181, 232, 0.2);
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        color: var(--text-dark, #5a5a6e);
        transition: background 0.2s;
    }

    .detail-close:hover {
        background: rgba(212, 181, 232, 0.45);
    }

    .detail-icon {
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .detail-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-dark, #5a5a6e);
        margin-bottom: 0.25rem;
    }

    .detail-category {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #d4b5e8;
        margin-bottom: 1rem;
    }

    .detail-section {
        margin-bottom: 1.2rem;
    }

    .detail-section h4 {
        font-family: 'Lato', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #d4b5e8;
        margin-bottom: 0.5rem;
    }

    .detail-section p {
        font-size: 0.95rem;
        color: var(--text-dark, #5a5a6e);
        line-height: 1.65;
        margin: 0;
    }

    .tech-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .tech-pill {
        background: linear-gradient(135deg, rgba(212, 181, 232, 0.35), rgba(245, 201, 212, 0.35));
        border: 1px solid rgba(212, 181, 232, 0.5);
        border-radius: 50px;
        padding: 4px 12px;
        font-size: 0.82rem;
        color: var(--text-dark, #5a5a6e);
        font-weight: 600;
    }

    .detail-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #d4b5e8;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.2s;
    }

    .detail-link:hover {
        color: #f5c9d4;
        text-decoration: underline;
    }

    .challenge-story {
        background: linear-gradient(135deg, rgba(255, 249, 196, 0.5), rgba(225, 245, 254, 0.5));
        border-left: 4px solid #d4b5e8;
        border-radius: 0 10px 10px 0;
        padding: 0.9rem 1rem;
        font-size: 0.93rem;
        color: var(--text-dark, #5a5a6e);
        line-height: 1.65;
    }

    /* ── Dark Mode ── */
    body.dark-mode .diagram-wrapper {
        background: rgba(22, 33, 62, 0.65);
        border-color: rgba(212, 181, 232, 0.2);
    }

    body.dark-mode .detail-panel {
        background: rgba(22, 33, 62, 0.97);
    }

    body.dark-mode .detail-title,
    body.dark-mode .detail-section p,
    body.dark-mode .challenge-story {
        color: #e0d0f0;
    }

    body.dark-mode .tech-pill {
        background: rgba(90, 60, 120, 0.5);
        color: #e0d0f0;
    }

    body.dark-mode .node-label {
        fill: #e0d0f0;
    }

    body.dark-mode .node-sublabel,
    body.dark-mode .connector-label {
        fill: #a090b0;
    }
</style>

<!-- Page Hero -->
<div class="arch-hero container">
    <h1>🗺️ Architecture Map</h1>
    <p>An interactive visual tour of my engineering work. Click any component to explore the tech, the reasoning, and the story behind it.</p>
</div>

<div class="container pb-5">

    <!-- Project Selector -->
    <div class="project-tabs" role="tablist" aria-label="Select a project architecture">
        <button class="project-tab active" role="tab" aria-selected="true"
                aria-controls="diagram-inventory" id="tab-inventory"
                onclick="switchProject('inventory', this)">
            🤖 AI Inventory System
        </button>
        <button class="project-tab" role="tab" aria-selected="false"
                aria-controls="diagram-financial" id="tab-financial"
                onclick="switchProject('financial', this)">
            💳 Cloud Financial App
        </button>
        <button class="project-tab" role="tab" aria-selected="false"
                aria-controls="diagram-portfolio" id="tab-portfolio"
                onclick="switchProject('portfolio', this)">
            🌸 This Portfolio
        </button>
    </div>

    <!-- Diagram Canvas -->
    <div class="diagram-wrapper">

        <!-- ── Project 1: AI Inventory System ── -->
        <div class="arch-diagram active" id="diagram-inventory" role="tabpanel" aria-labelledby="tab-inventory">
            <svg class="arch-svg" viewBox="0 0 820 460" aria-label="AI Inventory System architecture diagram">
                <defs>
                    <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#d4b5e8" />
                    </marker>
                    <marker id="arrowhead-green" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#c8e6c9" />
                    </marker>
                    <marker id="arrowhead-blue" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#b3e5fc" />
                    </marker>
                </defs>

                <!-- Connectors -->
                <!-- Client → API Gateway -->
                <line class="arch-connector" stroke="#d4b5e8" x1="130" y1="80" x2="240" y2="80" marker-end="url(#arrowhead)" />
                <!-- API Gateway → Azure Functions -->
                <line class="arch-connector" stroke="#d4b5e8" x1="360" y1="80" x2="455" y2="80" marker-end="url(#arrowhead)" />
                <!-- Azure Functions → Copilot Agent -->
                <line class="arch-connector" stroke="#d4b5e8" x1="555" y1="80" x2="655" y2="80" marker-end="url(#arrowhead)" />
                <!-- Azure Functions → Service Bus -->
                <line class="arch-connector" stroke="#c8e6c9" x1="505" y1="120" x2="505" y2="195" marker-end="url(#arrowhead-green)" />
                <!-- Service Bus → Inventory Processor -->
                <line class="arch-connector" stroke="#c8e6c9" x1="505" y1="255" x2="505" y2="320" marker-end="url(#arrowhead-green)" />
                <!-- Inventory Processor → SQL DB -->
                <line class="arch-connector" stroke="#b3e5fc" x1="455" y1="360" x2="330" y2="360" marker-end="url(#arrowhead-blue)" />
                <!-- Azure Functions → SQL DB (direct read) -->
                <path class="arch-connector" stroke="#b3e5fc" d="M 505 120 Q 360 200 300 320" marker-end="url(#arrowhead-blue)" stroke-dasharray="5,4" />
                <!-- Inventory Processor → Key Vault -->
                <line class="arch-connector" stroke="#f5c9d4" x1="555" y1="360" x2="645" y2="360" marker-end="url(#arrowhead)" stroke-dasharray="5,4" />
                <!-- App Insights (monitoring) -->
                <path class="arch-connector" stroke="#d4b5e8" d="M 130 130 Q 130 390 200 410" marker-end="url(#arrowhead)" stroke-dasharray="4,4" opacity="0.4" />

                <!-- Connector labels -->
                <text class="connector-label" x="190" y="70">HTTPS</text>
                <text class="connector-label" x="410" y="70">invoke</text>
                <text class="connector-label" x="610" y="70">AI prompt</text>
                <text class="connector-label" x="520" y="160">enqueue</text>
                <text class="connector-label" x="520" y="290">process</text>
                <text class="connector-label" x="390" y="350">write/read</text>

                <!-- ── Nodes ── -->
                <!-- Client / Browser -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Client Application - click for details"
                   onclick="openDetail('inv-client')" onkeydown="keyDetail(event,'inv-client')">
                    <rect class="node-box" x="10" y="50" width="120" height="70" rx="14"
                          fill="rgba(212,181,232,0.25)" stroke="#d4b5e8" stroke-width="2" />
                    <text class="node-icon" x="70" y="72">💻</text>
                    <text class="node-label" x="70" y="95">Client App</text>
                    <text class="node-sublabel" x="70" y="110">React / Web</text>
                </g>

                <!-- API Gateway / App Service -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure API Management - click for details"
                   onclick="openDetail('inv-apim')" onkeydown="keyDetail(event,'inv-apim')">
                    <rect class="node-box" x="240" y="50" width="120" height="70" rx="14"
                          fill="rgba(212,181,232,0.25)" stroke="#d4b5e8" stroke-width="2" />
                    <text class="node-icon" x="300" y="72">🌐</text>
                    <text class="node-label" x="300" y="95">Azure App</text>
                    <text class="node-sublabel" x="300" y="110">Service / APIM</text>
                </g>

                <!-- Azure Functions -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure Functions - click for details"
                   onclick="openDetail('inv-functions')" onkeydown="keyDetail(event,'inv-functions')">
                    <rect class="node-box" x="455" y="50" width="100" height="70" rx="14"
                          fill="rgba(200,230,201,0.3)" stroke="#c8e6c9" stroke-width="2" />
                    <text class="node-icon" x="505" y="72">⚡</text>
                    <text class="node-label" x="505" y="95">Azure</text>
                    <text class="node-sublabel" x="505" y="110">Functions</text>
                </g>

                <!-- Copilot Agent -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Copilot AI Agent - click for details"
                   onclick="openDetail('inv-copilot')" onkeydown="keyDetail(event,'inv-copilot')">
                    <rect class="node-box" x="655" y="50" width="120" height="70" rx="14"
                          fill="rgba(255,249,196,0.45)" stroke="#ffe082" stroke-width="2" />
                    <text class="node-icon" x="715" y="72">🤖</text>
                    <text class="node-label" x="715" y="95">Copilot Agent</text>
                    <text class="node-sublabel" x="715" y="110">AI Workflow</text>
                </g>

                <!-- Service Bus -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure Service Bus - click for details"
                   onclick="openDetail('inv-servicebus')" onkeydown="keyDetail(event,'inv-servicebus')">
                    <rect class="node-box" x="455" y="195" width="100" height="60" rx="14"
                          fill="rgba(200,230,201,0.3)" stroke="#c8e6c9" stroke-width="2" />
                    <text class="node-icon" x="505" y="214">📨</text>
                    <text class="node-label" x="505" y="235">Service Bus</text>
                    <text class="node-sublabel" x="505" y="248">Queue</text>
                </g>

                <!-- Inventory Processor Function -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Inventory Processor Function - click for details"
                   onclick="openDetail('inv-processor')" onkeydown="keyDetail(event,'inv-processor')">
                    <rect class="node-box" x="455" y="320" width="100" height="60" rx="14"
                          fill="rgba(200,230,201,0.3)" stroke="#c8e6c9" stroke-width="2" />
                    <text class="node-icon" x="505" y="338">🔄</text>
                    <text class="node-label" x="505" y="358">Inventory</text>
                    <text class="node-sublabel" x="505" y="371">Processor</text>
                </g>

                <!-- Azure SQL -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure SQL Database - click for details"
                   onclick="openDetail('inv-sql')" onkeydown="keyDetail(event,'inv-sql')">
                    <rect class="node-box" x="190" y="325" width="120" height="60" rx="14"
                          fill="rgba(179,229,252,0.35)" stroke="#b3e5fc" stroke-width="2" />
                    <text class="node-icon" x="250" y="344">🗄️</text>
                    <text class="node-label" x="250" y="364">Azure SQL</text>
                    <text class="node-sublabel" x="250" y="377">Database</text>
                </g>

                <!-- Azure Key Vault -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure Key Vault - click for details"
                   onclick="openDetail('inv-keyvault')" onkeydown="keyDetail(event,'inv-keyvault')">
                    <rect class="node-box" x="645" y="330" width="110" height="60" rx="14"
                          fill="rgba(245,201,212,0.35)" stroke="#f5c9d4" stroke-width="2" />
                    <text class="node-icon" x="700" y="350">🔑</text>
                    <text class="node-label" x="700" y="368">Key Vault</text>
                    <text class="node-sublabel" x="700" y="381">Secrets</text>
                </g>

                <!-- App Insights -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Application Insights - click for details"
                   onclick="openDetail('inv-appinsights')" onkeydown="keyDetail(event,'inv-appinsights')">
                    <rect class="node-box" x="135" y="390" width="120" height="60" rx="14"
                          fill="rgba(212,181,232,0.2)" stroke="#d4b5e8" stroke-width="2" stroke-dasharray="6,3" />
                    <text class="node-icon" x="195" y="410">📊</text>
                    <text class="node-label" x="195" y="430">App Insights</text>
                    <text class="node-sublabel" x="195" y="443">Monitoring</text>
                </g>
            </svg>

            <!-- Legend -->
            <div class="arch-legend">
                <div class="legend-item"><div class="legend-dot" style="background:#d4b5e8"></div>App / API Layer</div>
                <div class="legend-item"><div class="legend-dot" style="background:#c8e6c9"></div>Compute / Async</div>
                <div class="legend-item"><div class="legend-dot" style="background:#b3e5fc"></div>Data Storage</div>
                <div class="legend-item"><div class="legend-dot" style="background:#f5c9d4"></div>Security</div>
                <div class="legend-item"><div class="legend-dot" style="background:#ffe082"></div>AI Services</div>
            </div>
        </div>

        <!-- ── Project 2: Cloud Financial App ── -->
        <div class="arch-diagram" id="diagram-financial" role="tabpanel" aria-labelledby="tab-financial">
            <svg class="arch-svg" viewBox="0 0 820 460" aria-label="Cloud Financial Application architecture diagram">
                <defs>
                    <marker id="arrow2" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#d4b5e8" />
                    </marker>
                    <marker id="arrow2-green" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#c8e6c9" />
                    </marker>
                    <marker id="arrow2-blue" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#b3e5fc" />
                    </marker>
                </defs>

                <!-- Connectors -->
                <line class="arch-connector" stroke="#d4b5e8" x1="130" y1="80" x2="240" y2="80" marker-end="url(#arrow2)" />
                <line class="arch-connector" stroke="#d4b5e8" x1="360" y1="80" x2="450" y2="80" marker-end="url(#arrow2)" />
                <line class="arch-connector" stroke="#c8e6c9" x1="570" y1="80" x2="660" y2="80" marker-end="url(#arrow2-green)" />
                <line class="arch-connector" stroke="#c8e6c9" x1="300" y1="120" x2="300" y2="195" marker-end="url(#arrow2-green)" />
                <line class="arch-connector" stroke="#c8e6c9" x1="510" y1="120" x2="510" y2="195" marker-end="url(#arrow2-green)" />
                <line class="arch-connector" stroke="#b3e5fc" x1="300" y1="255" x2="300" y2="320" marker-end="url(#arrow2-blue)" />
                <line class="arch-connector" stroke="#b3e5fc" x1="510" y1="255" x2="510" y2="320" marker-end="url(#arrow2-blue)" />
                <line class="arch-connector" stroke="#d4b5e8" x1="350" y1="360" x2="460" y2="360" marker-end="url(#arrow2)" stroke-dasharray="5,4" />
                <!-- Hybrid -->
                <path class="arch-connector" stroke="#f5c9d4" d="M 700 120 Q 760 240 700 360" marker-end="url(#arrow2)" stroke-dasharray="6,4" />
                <text class="connector-label" x="773" y="240">Hybrid</text>
                <text class="connector-label" x="773" y="252">VPN/ER</text>

                <!-- Connector labels -->
                <text class="connector-label" x="190" y="70">HTTPS/TLS</text>
                <text class="connector-label" x="405" y="70">route</text>
                <text class="connector-label" x="618" y="70">on-prem</text>

                <!-- NSG boundary box -->
                <rect x="235" y="155" width="560" height="240" rx="12"
                      fill="none" stroke="rgba(245,201,212,0.5)" stroke-width="2" stroke-dasharray="8,5" />
                <text class="connector-label" x="320" y="175" font-size="11" fill="#f5c9d4" font-weight="700">NSG / Network Isolation Boundary</text>

                <!-- Client -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Internal Client - click for details"
