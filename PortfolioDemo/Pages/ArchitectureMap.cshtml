@page
@model ArchitectureMapModel
@{
    ViewData["Title"] = "Architecture Map";
    ViewData["Description"] = "Interactive architecture map of Monica Rivera's engineering projects — Azure Functions, SQL, hybrid connectivity, queues, and more.";
}

<style>
    /* ── Page Layout ── */
    .arch-hero {
        text-align: center;
        padding: 3rem 1rem 1.5rem;
    }

    .arch-hero h1 {
        font-size: 2.6rem;
        margin-bottom: 0.75rem;
    }

    .arch-hero p {
        color: var(--text-light, #8a8a9e);
        font-size: 1.05rem;
        max-width: 680px;
        margin: 0 auto 0.5rem;
    }

    /* ── Project Selector ── */
    .project-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .project-tab {
        background: rgba(255, 255, 255, 0.65);
        border: 2px solid rgba(212, 181, 232, 0.45);
        border-radius: 50px;
        padding: 8px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-dark, #5a5a6e);
        cursor: pointer;
        transition: all 0.25s ease;
        font-family: 'Lato', sans-serif;
        backdrop-filter: blur(6px);
    }

    .project-tab:hover,
    .project-tab.active {
        background: linear-gradient(135deg, rgba(212, 181, 232, 0.6), rgba(245, 201, 212, 0.6));
        border-color: rgba(212, 181, 232, 0.85);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(212, 181, 232, 0.3);
    }

    /* ── Diagram Canvas ── */
    .diagram-wrapper {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(12px);
        border: 2px solid rgba(212, 181, 232, 0.3);
        border-radius: 20px;
        padding: 2rem 1rem;
        box-shadow: 0 8px 32px rgba(212, 181, 232, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        min-height: 480px;
        position: relative;
        overflow-x: auto;
    }

    /* ── Architecture Diagram ── */
    .arch-diagram {
        display: none;
        animation: fadeInUp 0.4s ease-out;
    }

    .arch-diagram.active {
        display: block;
    }

    .arch-svg {
        width: 100%;
        max-width: 820px;
        display: block;
        margin: 0 auto;
        overflow: visible;
    }

    /* ── Node Styles ── */
    .arch-node {
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .arch-node:hover .node-box {
        filter: drop-shadow(0 0 12px rgba(212, 181, 232, 0.7));
        transform: translateY(-3px);
    }

    .arch-node:focus .node-box {
        outline: 3px solid #d4b5e8;
        outline-offset: 3px;
    }

    .node-box {
        transition: transform 0.25s ease, filter 0.25s ease;
        transform-origin: center;
    }

    .node-label {
        font-family: 'Lato', sans-serif;
        font-weight: 700;
        font-size: 13px;
        fill: #5a5a6e;
        pointer-events: none;
        dominant-baseline: central;
        text-anchor: middle;
    }

    .node-icon {
        font-size: 20px;
        pointer-events: none;
        dominant-baseline: central;
        text-anchor: middle;
    }

    .node-sublabel {
        font-family: 'Lato', sans-serif;
        font-size: 10px;
        fill: #8a8a9e;
        pointer-events: none;
        dominant-baseline: central;
        text-anchor: middle;
    }

    /* ── Connector Lines ── */
    .arch-connector {
        stroke-width: 2;
        fill: none;
        opacity: 0.6;
        marker-end: url(#arrowhead);
    }

    .connector-label {
        font-family: 'Lato', sans-serif;
        font-size: 10px;
        fill: #8a8a9e;
        text-anchor: middle;
    }

    /* ── Legend ── */
    .arch-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1.5rem;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8rem;
        color: var(--text-light, #8a8a9e);
    }

    .legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        flex-shrink: 0;
    }

    /* ── Hint ── */
    .click-hint {
        text-align: center;
        font-size: 0.82rem;
        color: var(--text-light, #8a8a9e);
        margin-top: 1rem;
        font-style: italic;
    }

    /* ── Detail Panel (slide-in) ── */
    .detail-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(90, 90, 110, 0.25);
        backdrop-filter: blur(3px);
        z-index: 1040;
        animation: fadeIn 0.2s ease;
    }

    .detail-overlay.open {
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .detail-panel {
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(20px);
        border-radius: 24px 24px 0 0;
        padding: 2rem;
        width: 100%;
        max-width: 680px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 -8px 40px rgba(212, 181, 232, 0.3);
        animation: slideUp 0.3s ease;
        position: relative;
    }

    @@media (min-width: 768px) {
        .detail-overlay.open {
            align-items: center;
        }

        .detail-panel {
            border-radius: 24px;
            max-height: 80vh;
            animation: popIn 0.3s ease;
        }
    }

    @@keyframes slideUp {
        from { transform: translateY(100%); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
    }

    @@keyframes popIn {
        from { transform: scale(0.92); opacity: 0; }
        to   { transform: scale(1);    opacity: 1; }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .detail-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(212, 181, 232, 0.2);
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        color: var(--text-dark, #5a5a6e);
        transition: background 0.2s;
    }

    .detail-close:hover {
        background: rgba(212, 181, 232, 0.45);
    }

    .detail-icon {
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .detail-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-dark, #5a5a6e);
        margin-bottom: 0.25rem;
    }

    .detail-category {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #d4b5e8;
        margin-bottom: 1rem;
    }

    .detail-section {
        margin-bottom: 1.2rem;
    }

    .detail-section h4 {
        font-family: 'Lato', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #d4b5e8;
        margin-bottom: 0.5rem;
    }

    .detail-section p {
        font-size: 0.95rem;
        color: var(--text-dark, #5a5a6e);
        line-height: 1.65;
        margin: 0;
    }

    .tech-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .tech-pill {
        background: linear-gradient(135deg, rgba(212, 181, 232, 0.35), rgba(245, 201, 212, 0.35));
        border: 1px solid rgba(212, 181, 232, 0.5);
        border-radius: 50px;
        padding: 4px 12px;
        font-size: 0.82rem;
        color: var(--text-dark, #5a5a6e);
        font-weight: 600;
    }

    .detail-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #d4b5e8;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.2s;
    }

    .detail-link:hover {
        color: #f5c9d4;
        text-decoration: underline;
    }

    .challenge-story {
        background: linear-gradient(135deg, rgba(255, 249, 196, 0.5), rgba(225, 245, 254, 0.5));
        border-left: 4px solid #d4b5e8;
        border-radius: 0 10px 10px 0;
        padding: 0.9rem 1rem;
        font-size: 0.93rem;
        color: var(--text-dark, #5a5a6e);
        line-height: 1.65;
    }

    /* ── Dark Mode ── */
    body.dark-mode .diagram-wrapper {
        background: rgba(22, 33, 62, 0.65);
        border-color: rgba(212, 181, 232, 0.2);
    }

    body.dark-mode .detail-panel {
        background: rgba(22, 33, 62, 0.97);
    }

    body.dark-mode .detail-title,
    body.dark-mode .detail-section p,
    body.dark-mode .challenge-story {
        color: #e0d0f0;
    }

    body.dark-mode .tech-pill {
        background: rgba(90, 60, 120, 0.5);
        color: #e0d0f0;
    }

    body.dark-mode .node-label {
        fill: #e0d0f0;
    }

    body.dark-mode .node-sublabel,
    body.dark-mode .connector-label {
        fill: #a090b0;
    }
</style>

<!-- Page Hero -->
<div class="arch-hero container">
    <h1>🗺️ Architecture Map</h1>
    <p>An interactive visual tour of my engineering work. Click any component to explore the tech, the reasoning, and the story behind it.</p>
</div>

<div class="container pb-5">

    <!-- Diagram Canvas -->
    <div class="diagram-wrapper">

        <!-- ── Project 3: This Portfolio ── -->
        <div class="arch-diagram active" id="diagram-portfolio" role="tabpanel" aria-labelledby="tab-portfolio">
            <svg class="arch-svg" viewBox="0 0 900 420" aria-label="Portfolio application architecture diagram">
                <defs>
                    <marker id="arrow3" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#d4b5e8" />
                    </marker>
                    <marker id="arrow3-green" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#c8e6c9" />
                    </marker>
                    <marker id="arrow3-blue" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#b3e5fc" />
                    </marker>
                    <marker id="arrow3-pink" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
                        <polygon points="0 0, 8 3, 0 6" fill="#f5c9d4" />
                    </marker>
                </defs>

                <!-- Connectors -->
                <line class="arch-connector" stroke="#d4b5e8" x1="140" y1="100" x2="230" y2="100" marker-end="url(#arrow3)" />
                <line class="arch-connector" stroke="#d4b5e8" x1="370" y1="100" x2="450" y2="100" marker-end="url(#arrow3)" />
                <line class="arch-connector" stroke="#c8e6c9" x1="600" y1="100" x2="680" y2="100" marker-end="url(#arrow3-green)" />
                <line class="arch-connector" stroke="#b3e5fc" x1="310" y1="140" x2="310" y2="220" marker-end="url(#arrow3-blue)" />
                <line class="arch-connector" stroke="#c8e6c9" x1="520" y1="140" x2="520" y2="220" marker-end="url(#arrow3-green)" />
                <!-- CI/CD pipeline -->
                <path class="arch-connector" stroke="#d4b5e8" d="M 85 55 Q 85 20 310 20 Q 535 20 535 55" marker-end="url(#arrow3)" stroke-dasharray="5,4" />
                <text class="connector-label" x="310" y="15">GitHub Actions CI/CD Pipeline</text>

                <!-- Connector labels -->
                <text class="connector-label" x="185" y="90">HTTPS</text>
                <text class="connector-label" x="410" y="90">API call</text>
                <text class="connector-label" x="643" y="90">streams</text>
                <text class="connector-label" x="326" y="180">download</text>

                <!-- Visitor -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Visitor / Browser - click for details"
                   onclick="openDetail('port-visitor')" onkeydown="keyDetail(event,'port-visitor')">
                    <rect class="node-box" x="10" y="65" width="130" height="70" rx="14"
                          fill="rgba(212,181,232,0.25)" stroke="#d4b5e8" stroke-width="2" />
                    <text class="node-icon" x="75" y="87">🌐</text>
                    <text class="node-label" x="75" y="110">Visitor</text>
                    <text class="node-sublabel" x="75" y="124">Browser / Device</text>
                </g>

                <!-- Azure Web App -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure Web App Service (ASP.NET Core) - click for details"
                   onclick="openDetail('port-webapp')" onkeydown="keyDetail(event,'port-webapp')">
                    <rect class="node-box" x="230" y="65" width="140" height="70" rx="14"
                          fill="rgba(212,181,232,0.25)" stroke="#d4b5e8" stroke-width="2" />
                    <text class="node-icon" x="300" y="87">🌸</text>
                    <text class="node-label" x="300" y="110">Azure Web App</text>
                    <text class="node-sublabel" x="300" y="124">ASP.NET Core 8</text>
                </g>

                <!-- Claude AI API -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Claude AI (Anthropic) API - click for details"
                   onclick="openDetail('port-claude')" onkeydown="keyDetail(event,'port-claude')">
                    <rect class="node-box" x="450" y="65" width="150" height="70" rx="14"
                          fill="rgba(255,249,196,0.45)" stroke="#ffe082" stroke-width="2" />
                    <text class="node-icon" x="525" y="87">🤖</text>
                    <text class="node-label" x="525" y="110">Claude AI</text>
                    <text class="node-sublabel" x="525" y="124">Anthropic API</text>
                </g>

                <!-- Streaming response -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Server-Sent Events Streaming - click for details"
                   onclick="openDetail('port-sse')" onkeydown="keyDetail(event,'port-sse')">
                    <rect class="node-box" x="680" y="65" width="120" height="70" rx="14"
                          fill="rgba(200,230,201,0.3)" stroke="#c8e6c9" stroke-width="2" />
                    <text class="node-icon" x="740" y="87">📡</text>
                    <text class="node-label" x="740" y="110">Streaming</text>
                    <text class="node-sublabel" x="740" y="124">SSE Response</text>
                </g>

                <!-- Azure Storage Account -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure Storage Account - click for details"
                   onclick="openDetail('port-filestorage')" onkeydown="keyDetail(event,'port-filestorage')">
                    <rect class="node-box" x="240" y="220" width="140" height="60" rx="14"
                          fill="rgba(179,229,252,0.35)" stroke="#b3e5fc" stroke-width="2" />
                    <text class="node-icon" x="310" y="240">📁</text>
                    <text class="node-label" x="310" y="260">Azure Storage</text>
                    <text class="node-sublabel" x="310" y="273">Account</text>
                </g>

                <!-- Azure Key Vault -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure Key Vault (Secrets) - click for details"
                   onclick="openDetail('port-keyvault')" onkeydown="keyDetail(event,'port-keyvault')">
                    <rect class="node-box" x="460" y="220" width="120" height="60" rx="14"
                          fill="rgba(245,201,212,0.35)" stroke="#f5c9d4" stroke-width="2" />
                    <text class="node-icon" x="520" y="240">🔑</text>
                    <text class="node-label" x="520" y="260">Key Vault</text>
                    <text class="node-sublabel" x="520" y="273">API Keys / Secrets</text>
                </g>

                <!-- App Insights -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Application Insights Monitoring - click for details"
                   onclick="openDetail('port-appinsights')" onkeydown="keyDetail(event,'port-appinsights')">
                    <rect class="node-box" x="240" y="320" width="140" height="60" rx="14"
                          fill="rgba(212,181,232,0.2)" stroke="#d4b5e8" stroke-width="2" stroke-dasharray="6,3" />
                    <text class="node-icon" x="310" y="340">📊</text>
                    <text class="node-label" x="310" y="360">App Insights</text>
                    <text class="node-sublabel" x="310" y="373">Telemetry & Monitoring</text>
                </g>

                <line class="arch-connector" stroke="#d4b5e8" x1="310" y1="280" x2="310" y2="320" marker-end="url(#arrow3)" stroke-dasharray="4,4" opacity="0.5" />
                <line class="arch-connector" stroke="#f5c9d4" x1="520" y1="140" x2="520" y2="220" marker-end="url(#arrow3-pink)" stroke-dasharray="4,4" />

                <!-- APIM dashed connector from Web App -->
                <line class="arch-connector" stroke="#d4b5e8" x1="370" y1="130" x2="450" y2="310" marker-end="url(#arrow3)" stroke-dasharray="5,4" opacity="0.6" />
                <text class="connector-label" x="392" y="230">API gateway</text>

                <!-- Azure API Management (Planned) -->
                <g class="arch-node" tabindex="0" role="button"
                   aria-label="Azure API Management (Planned) - click for details"
                   onclick="openDetail('port-apim')" onkeydown="keyDetail(event,'port-apim')">
                    <rect class="node-box" x="450" y="310" width="130" height="60" rx="14"
                          fill="rgba(212,181,232,0.15)" stroke="#d4b5e8" stroke-width="2" stroke-dasharray="6,3" />
                    <text class="node-icon" x="515" y="330">🌐</text>
                    <text class="node-label" x="515" y="350">Azure APIM</text>
                    <text class="node-sublabel" x="515" y="363">Planned</text>
                </g>
            </svg>

            <div class="arch-legend">
                <div class="legend-item"><div class="legend-dot" style="background:#d4b5e8"></div>Web / API Layer</div>
                <div class="legend-item"><div class="legend-dot" style="background:#ffe082"></div>AI Service</div>
                <div class="legend-item"><div class="legend-dot" style="background:#b3e5fc"></div>Storage</div>
                <div class="legend-item"><div class="legend-dot" style="background:#f5c9d4"></div>Security</div>
                <div class="legend-item"><div class="legend-dot" style="background:#c8e6c9"></div>Real-Time / Streaming</div>
                <div class="legend-item"><div class="legend-dot" style="background:rgba(212,181,232,0.15); border:1px dashed #d4b5e8"></div>Planned / In Progress</div>
            </div>
        </div>

        <p class="click-hint"><i class="fas fa-mouse-pointer d-none d-md-inline"></i><i class="fas fa-hand-pointer d-inline d-md-none"></i> <span class="d-none d-md-inline">Click</span><span class="d-inline d-md-none">Tap</span> any component to explore the technology, design decisions, and engineering story</p>
    </div>
</div>

<!-- ── Detail Panel Overlay ── -->
<div class="detail-overlay" id="detailOverlay" role="dialog" aria-modal="true" aria-labelledby="detailTitle"
     onclick="closeDetailOnBackdrop(event)">
    <div class="detail-panel" id="detailPanel">
        <button class="detail-close" onclick="closeDetail()" aria-label="Close detail panel">
            <i class="fas fa-times"></i>
        </button>
        <span class="detail-icon" id="detailIcon" aria-hidden="true"></span>
        <div class="detail-category" id="detailCategory"></div>
        <div class="detail-title" id="detailTitle"></div>

        <div class="detail-section">
            <h4><i class="fas fa-layer-group"></i> Technologies Used</h4>
            <div class="tech-pills" id="detailTech"></div>
        </div>

        <div class="detail-section">
            <h4><i class="fas fa-lightbulb"></i> Why I Chose This</h4>
            <p id="detailWhy"></p>
        </div>

        <div class="detail-section">
            <h4><i class="fas fa-road"></i> Challenge → Solution</h4>
            <div class="challenge-story" id="detailStory"></div>
        </div>

        <div class="detail-section" id="detailLinksSection">
            <h4><i class="fas fa-code"></i> Code &amp; Resources</h4>
            <div id="detailLinks"></div>
        </div>
    </div>
</div>

<script>
/* ══════════════════════════════════════════════
   Architecture Map — Component Data
═══════════════════════════════════════════════ */
const componentData = {


    /* ── Portfolio ── */
    'port-visitor': {
        icon: '🌐', category: 'Client Layer',
        title: 'Visitor / Browser',
        tech: ['HTML5', 'CSS3', 'Bootstrap 5', 'Vanilla JavaScript', 'Fetch API', 'Server-Sent Events'],
        why: 'No framework overhead — the portfolio is content-first and should load fast on any device. Bootstrap 5 provides responsive layout with minimal custom CSS, and Vanilla JS keeps the bundle size to zero.',
        story: '<strong>Challenge:</strong> Making the AI chat feel responsive on a slow connection without a heavy frontend framework.<br><br><strong>Solution:</strong> Used the Fetch API with streaming response handling so the AI reply text appears word-by-word as it arrives, giving immediate feedback without waiting for the full response.',
        links: [{ label: 'View Source on GitHub', url: 'https://github.com/monicarivera-work/monicarivera_portfolio_demo' }]
    },
    'port-webapp': {
        icon: '🌸', category: 'Web Application',
        title: 'Azure Web App — ASP.NET Core 8',
        tech: ['ASP.NET Core 8', 'Razor Pages', 'C# 12', 'Dependency Injection', 'Azure Web App Service'],
        why: 'Azure Web App was chosen because it was a quick and easy way to get a Razor Pages website up and running that is easily customizable but still able to support more complicated components as the portfolio grows.',
        story: '<strong>Challenge:</strong> Keeping secrets (API keys, connection strings) out of source control while making them easy to inject at runtime in Azure.<br><br><strong>Solution:</strong> Used ASP.NET Core\'s configuration system backed by Azure Key Vault and App Service Application Settings. Local development uses user-secrets; production reads from Key Vault via Managed Identity—same code, zero secrets in Git.',
        links: [{ label: 'GitHub Repository', url: 'https://github.com/monicarivera-work/monicarivera_portfolio_demo' }]
    },
    'port-claude': {
        icon: '🤖', category: 'AI Service',
        title: 'Claude AI (Anthropic)',
        tech: ['Claude 3 Haiku / Sonnet', 'Anthropic Messages API', 'System Prompt Engineering', 'HttpClient', 'JSON Streaming'],
        why: 'Claude AI was chosen because it is important to demonstrate a proficiency with AI tools and to show adaptability to modern technology. Integrating a real AI API — rather than a mock — shows that Monica can evaluate, connect to, and ship production-grade AI features.',
        story: '<strong>Challenge:</strong> Making the AI stay on-topic about Monica\'s background without hallucinating fabricated credentials or job history.<br><br><strong>Solution:</strong> Engineered a detailed system prompt that grounds the model with factual information about Monica\'s skills and experience. The prompt explicitly instructs the model to say "I don\'t know" rather than guess—keeping all responses accurate and on-brand.',
        links: [{ label: 'Anthropic API Docs', url: 'https://docs.anthropic.com' }]
    },
    'port-sse': {
        icon: '📡', category: 'Real-Time Streaming',
