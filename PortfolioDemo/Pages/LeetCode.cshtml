@page
@model LeetCodeModel
@{
    ViewData["Title"] = "LeetCode Analytics";
    ViewData["Description"] = "Monica Rivera's LeetCode progress — solved problems, rankings, and recent activity.";
}

<style>
    .lc-hero {
        text-align: center;
        padding: 3rem 1rem 1.5rem;
    }
    .lc-hero h1 { font-size: 2.6rem; margin-bottom: 0.5rem; }
    .lc-hero p { color: var(--text-light); font-size: 1.05rem; margin: 0 auto; max-width: 600px; }

    .lc-profile-card {
        background: rgba(255,255,255,0.7);
        backdrop-filter: blur(12px);
        border: 1.5px solid rgba(212,181,232,0.4);
        border-radius: 20px;
        padding: 1.8rem;
        box-shadow: 0 8px 32px rgba(212,181,232,0.2);
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }
    .lc-avatar {
        width: 80px; height: 80px;
        border-radius: 50%;
        border: 3px solid rgba(212,181,232,0.6);
        object-fit: cover;
    }
    .lc-avatar-placeholder {
        width: 80px; height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4b5e8, #f5c9d4);
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; color: white;
        flex-shrink: 0;
    }
    .lc-profile-info h2 { margin: 0 0 0.25rem; font-size: 1.5rem; }
    .lc-profile-info p { margin: 0; color: var(--text-light); }
    .lc-rank-badge {
        background: linear-gradient(135deg, #d4b5e8, #f5c9d4);
        color: #5a5a6e; font-weight: 700; font-size: 0.9rem;
        padding: 4px 14px; border-radius: 50px; display: inline-block; margin-top: 0.4rem;
    }

    .lc-stat-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .lc-stat-card {
        background: rgba(255,255,255,0.7); backdrop-filter: blur(10px);
        border-radius: 16px; padding: 1.2rem; text-align: center;
        border: 1.5px solid rgba(212,181,232,0.3);
        box-shadow: 0 4px 16px rgba(212,181,232,0.15);
        transition: transform 0.2s;
    }
    .lc-stat-card:hover { transform: translateY(-3px); }
    .lc-stat-card .stat-num { font-size: 2.2rem; font-weight: 700; font-family: 'Playfair Display', serif; }
    .lc-stat-card .stat-label { font-size: 0.85rem; color: var(--text-light); margin-top: 0.2rem; }
    .lc-stat-card.easy .stat-num { color: #5cb85c; }
    .lc-stat-card.medium .stat-num { color: #f0ad4e; }
    .lc-stat-card.hard .stat-num { color: #d9534f; }
    .lc-stat-card.total .stat-num { color: #7b5ea7; }

    .lc-chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
    @@media (max-width: 700px) { .lc-chart-row { grid-template-columns: 1fr; } }
    .lc-chart-box {
        background: rgba(255,255,255,0.7); backdrop-filter: blur(10px);
        border-radius: 20px; padding: 1.5rem;
        border: 1.5px solid rgba(212,181,232,0.3);
        box-shadow: 0 4px 20px rgba(212,181,232,0.15);
    }
    .lc-chart-box h3 { font-size: 1.1rem; margin-bottom: 1rem; }

    .lc-progress-bar-row { display: flex; align-items: center; margin-bottom: 0.6rem; gap: 0.7rem; }
    .lc-progress-label { min-width: 70px; font-size: 0.9rem; font-weight: 600; }
    .lc-progress-track { flex: 1; background: rgba(0,0,0,0.07); border-radius: 50px; height: 14px; overflow: hidden; }
    .lc-progress-fill { height: 100%; border-radius: 50px; transition: width 1s ease; }
    .lc-progress-fill.easy { background: linear-gradient(90deg, #5cb85c, #81c784); }
    .lc-progress-fill.medium { background: linear-gradient(90deg, #f0ad4e, #ffcc80); }
    .lc-progress-fill.hard { background: linear-gradient(90deg, #d9534f, #ef9a9a); }
    .lc-progress-count { min-width: 60px; font-size: 0.85rem; color: var(--text-light); text-align: right; }

    .lc-submissions-list {
        background: rgba(255,255,255,0.7); backdrop-filter: blur(10px);
        border-radius: 20px; padding: 1.5rem;
        border: 1.5px solid rgba(212,181,232,0.3);
        box-shadow: 0 4px 20px rgba(212,181,232,0.15);
        margin-bottom: 2rem;
    }
    .lc-submissions-list h3 { font-size: 1.15rem; margin-bottom: 1rem; }
    .lc-sub-item {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.6rem 0; border-bottom: 1px solid rgba(212,181,232,0.2);
        flex-wrap: wrap; gap: 0.3rem;
    }
    .lc-sub-item:last-child { border-bottom: none; }
    .lc-sub-title { font-weight: 500; color: var(--text-dark); text-decoration: none; }
    .lc-sub-title:hover { color: #7b5ea7; }
    .lc-sub-meta { font-size: 0.8rem; color: var(--text-light); }
    .lc-lang-badge {
        font-size: 0.75rem; background: rgba(212,181,232,0.3);
        padding: 2px 8px; border-radius: 50px; color: #5a5a6e;
    }

    .lc-loading { text-align: center; padding: 4rem; color: var(--text-light); }
    .lc-spinner {
        width: 50px; height: 50px; border: 4px solid rgba(212,181,232,0.3);
        border-top-color: #d4b5e8; border-radius: 50%; animation: spin 0.9s linear infinite;
        margin: 0 auto 1rem;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .lc-error { text-align: center; padding: 3rem; color: #d9534f; }
    .lc-leetcode-link {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: linear-gradient(135deg, #d4b5e8, #f5c9d4);
        color: #5a5a6e; font-weight: 600; padding: 8px 18px;
        border-radius: 50px; text-decoration: none; font-size: 0.9rem;
        transition: opacity 0.2s; margin-left: auto;
    }
    .lc-leetcode-link:hover { opacity: 0.85; color: #5a5a6e; }
</style>

<div class="lc-hero">
    <h1>🧩 LeetCode Analytics</h1>
    <p>Live progress from <strong>NickyRivers6543</strong>'s public LeetCode profile — updated on every page visit.</p>
</div>

<div class="container pb-5">
    <!-- Loading state -->
    <div id="lcLoading" class="lc-loading">
        <div class="lc-spinner"></div>
        <p>Fetching LeetCode data…</p>
    </div>

    <!-- Error state -->
    <div id="lcError" class="lc-error" style="display:none;">
        <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
        <p id="lcErrorMsg">Unable to load LeetCode data at this time.</p>
        <a href="https://leetcode.com/u/NickyRivers6543/" target="_blank" rel="noopener" class="btn btn-primary-flowery mt-2">View on LeetCode ↗</a>
    </div>

    <!-- Content (hidden until loaded) -->
    <div id="lcContent" style="display:none;">
        <!-- Profile card -->
        <div class="lc-profile-card">
            <div id="lcAvatarWrap">
                <div class="lc-avatar-placeholder">👩‍💻</div>
            </div>
            <div class="lc-profile-info">
                <h2 id="lcRealName">NickyRivers6543</h2>
                <p>LeetCode: <strong>NickyRivers6543</strong></p>
                <div id="lcRankBadge" class="lc-rank-badge" style="display:none;"></div>
            </div>
            <a href="https://leetcode.com/u/NickyRivers6543/" target="_blank" rel="noopener" class="lc-leetcode-link ms-auto">
                <i class="fas fa-external-link-alt"></i> View Profile
            </a>
        </div>

        <!-- Stat cards -->
        <div class="lc-stat-cards">
            <div class="lc-stat-card total">
                <div class="stat-num" id="lcTotal">—</div>
                <div class="stat-label">Total Solved</div>
            </div>
            <div class="lc-stat-card easy">
                <div class="stat-num" id="lcEasy">—</div>
                <div class="stat-label">Easy Solved</div>
            </div>
            <div class="lc-stat-card medium">
                <div class="stat-num" id="lcMedium">—</div>
                <div class="stat-label">Medium Solved</div>
            </div>
            <div class="lc-stat-card hard">
                <div class="stat-num" id="lcHard">—</div>
                <div class="stat-label">Hard Solved</div>
            </div>
        </div>

        <!-- Charts row -->
        <div class="lc-chart-row">
            <!-- Donut chart -->
            <div class="lc-chart-box" style="display:flex;flex-direction:column;align-items:center;">
                <h3>Problems by Difficulty</h3>
                <canvas id="lcDonut" width="220" height="220" style="max-width:220px;"></canvas>
            </div>
            <!-- Progress bars -->
            <div class="lc-chart-box">
                <h3>Progress by Difficulty</h3>
                <div id="lcProgressBars"></div>
                <p class="mt-3 mb-0" style="font-size:0.85rem;color:var(--text-light);">Based on total available problems on LeetCode.</p>
            </div>
        </div>

        <!-- Recent accepted submissions -->
        <div class="lc-submissions-list">
            <h3>🏆 Recent Accepted Submissions</h3>
            <div id="lcSubsList">
                <p class="text-muted">No recent submissions found.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.js"
        integrity="sha256-bnCMssK0FgTbH13sAXJIVuxTrIZ4maHk4s+48Kzmvtk="
        crossorigin="anonymous"></script>
<script>
(function () {
    const loading = document.getElementById('lcLoading');
    const error   = document.getElementById('lcError');
    const content = document.getElementById('lcContent');

    fetch('/api/leetcode/stats')
        .then(r => {
            if (!r.ok) throw new Error('API returned ' + r.status);
            return r.json();
        })
        .then(data => {
            loading.style.display = 'none';
            content.style.display = '';

            // Profile
            if (data.realName) document.getElementById('lcRealName').textContent = data.realName;
            if (data.ranking && data.ranking > 0) {
                const b = document.getElementById('lcRankBadge');
                b.textContent = '🏅 Global Rank #' + data.ranking.toLocaleString();
                b.style.display = 'inline-block';
            }
            if (data.userAvatar) {
                document.getElementById('lcAvatarWrap').innerHTML =
                    '<img class="lc-avatar" src="' + data.userAvatar + '" alt="avatar" />';
            }

            // Stat cards
            document.getElementById('lcTotal').textContent  = data.totalSolved;
            document.getElementById('lcEasy').textContent   = data.easySolved;
            document.getElementById('lcMedium').textContent = data.mediumSolved;
            document.getElementById('lcHard').textContent   = data.hardSolved;

            // Donut chart
            const ctx = document.getElementById('lcDonut').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Easy', 'Medium', 'Hard'],
                    datasets: [{
                        data: [data.easySolved, data.mediumSolved, data.hardSolved],
                        backgroundColor: ['#81c784', '#ffcc80', '#ef9a9a'],
                        borderColor: ['#5cb85c', '#f0ad4e', '#d9534f'],
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { size: 13 } } },
                        tooltip: { callbacks: { label: ctx => ' ' + ctx.label + ': ' + ctx.parsed } }
                    },
                    cutout: '62%'
                }
            });

            // Progress bars
            const makeBar = (label, solved, total, cls) => {
                const pct = total > 0 ? Math.min(100, Math.round(solved / total * 100)) : 0;
                return `<div class="lc-progress-bar-row">
                    <span class="lc-progress-label ${cls}">${label}</span>
                    <div class="lc-progress-track">
                        <div class="lc-progress-fill ${cls}" style="width:${pct}%"></div>
                    </div>
                    <span class="lc-progress-count">${solved} / ${total}</span>
                </div>`;
            };
            document.getElementById('lcProgressBars').innerHTML =
                makeBar('Easy',   data.easySolved,   data.totalEasy   || 1, 'easy')   +
                makeBar('Medium', data.mediumSolved, data.totalMedium || 1, 'medium') +
                makeBar('Hard',   data.hardSolved,   data.totalHard   || 1, 'hard');

            // Recent submissions
            const subs = data.recentSubmissions || [];
            if (subs.length > 0) {
                const html = subs.map(s => {
                    const date = new Date(Number(s.timestamp) * 1000);
                    const dateStr = date.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
                    return `<div class="lc-sub-item">
                        <a class="lc-sub-title" href="https://leetcode.com/problems/${s.titleSlug}/" target="_blank" rel="noopener">${s.title}</a>
                        <span class="lc-sub-meta">
                            <span class="lc-lang-badge">${s.language}</span>
                            &nbsp;${dateStr}
                        </span>
                    </div>`;
                }).join('');
                document.getElementById('lcSubsList').innerHTML = html;
            }
        })
        .catch(err => {
            loading.style.display = 'none';
            document.getElementById('lcErrorMsg').textContent = 'Unable to load LeetCode data: ' + err.message;
            error.style.display = '';
        });
})();
</script>
}
