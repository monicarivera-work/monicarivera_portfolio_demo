@page
@model MiniGameModel
@{
    ViewData["Title"] = "Mini Game";
    ViewData["Description"] = "Take a break — play Monica's Gravity Flip platformer. How long can you survive?";
}

<style>
    .game-page-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem 3rem;
        min-height: calc(100vh - 140px);
    }

    .game-page-wrapper h1 {
        font-family: 'Playfair Display', serif;
        margin-bottom: 0.5rem;
    }

    .game-subtitle {
        color: #5a5a6e;
        font-family: 'Lato', sans-serif;
        margin-bottom: 1.5rem;
        font-size: 1rem;
        text-align: center;
    }

    body.dark-mode .game-subtitle {
        color: #c8b8d8;
    }

    #gameCanvas {
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(180, 120, 220, 0.25), 0 2px 8px rgba(0,0,0,0.12);
        display: block;
        max-width: 100%;
        cursor: pointer;
        touch-action: none;
    }

    .game-hint {
        margin-top: 0.75rem;
        font-family: 'Lato', sans-serif;
        font-size: 0.85rem;
        color: #8a7a9e;
        text-align: center;
    }

    body.dark-mode .game-hint {
        color: #b0a0c8;
    }

    /* Mobile tap button — shown only on touch devices */
    .mobile-tap-btn {
        display: none;
        margin-top: 1rem;
        background: linear-gradient(135deg, #d4b5e8, #f5c9d4);
        border: none;
        border-radius: 50px;
        padding: 14px 40px;
        font-family: 'Lato', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #4a3060;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(212, 181, 232, 0.4);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        -webkit-tap-highlight-color: transparent;
        user-select: none;
    }

    .mobile-tap-btn:active {
        transform: scale(0.96);
        box-shadow: 0 2px 10px rgba(212, 181, 232, 0.3);
    }

    body.dark-mode .mobile-tap-btn {
        color: #2a1040;
    }

    @@media (max-width: 768px) {
        .game-page-wrapper {
            padding: 1.25rem 0.5rem 2rem;
        }

        .game-hint .keyboard-hint {
            display: none;
        }
    }

    @@media (hover: none) and (pointer: coarse) {
        /* Touch-only devices: show the tap button */
        .mobile-tap-btn {
            display: inline-block;
        }
    }
</style>

<div class="game-page-wrapper">
    <h1>🎮 Gravity Flip</h1>
    <p class="game-subtitle">Guide your 🐶 puppy — flip gravity to dodge gaps and enemy fireballs!</p>
    <canvas id="gameCanvas" width="800" height="400" aria-label="Gravity Flip platformer game. Press Space or tap to flip gravity and avoid gaps." role="application" tabindex="0"></canvas>
    <p class="game-hint"><span class="keyboard-hint">Press <strong>Space</strong> or </span><strong>tap</strong> to flip gravity &nbsp;|&nbsp; Avoid gaps &amp; enemy fireballs!</p>
    <button class="mobile-tap-btn" id="mobileTapBtn" aria-label="Tap to flip gravity">👆 Tap to Flip!</button>
</div>

<script>
(function () {
    'use strict';

    /* ── Canvas setup ── */
    const canvas  = document.getElementById('gameCanvas');
    const ctx     = canvas.getContext('2d');

    /* Responsive sizing — scales the canvas CSS display size to fit the viewport
       while keeping the internal 800×400 resolution (crisp rendering via CSS scale). */
    function resizeCanvas() {
        const padding = window.innerWidth <= 480 ? 16 : 32;
        const maxW = Math.min(800, window.innerWidth - padding);
      
        const scale = maxW / 800;
        canvas.style.width  = maxW + 'px';
        canvas.style.height = Math.round(400 * scale) + 'px';
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    /* ── Mobile tap button ── */
    const mobileTapBtn = document.getElementById('mobileTapBtn');
    if (mobileTapBtn) {
        mobileTapBtn.addEventListener('pointerdown', function (e) {
            e.preventDefault();
            if (state === 'intro' || state === 'gameover') {
                startGame();
            } else {
                flip();
            }
        });
    }

    /* ── Colour palette (light / dark mode) ── */
    function palette() {
        const dark = document.body.classList.contains('dark-mode');
        return {
            bg1      : dark ? 'rgba(40,30,55,0.98)'         : 'rgba(245,240,255,0.98)',
            bg2      : dark ? 'rgba(55,35,70,0.98)'         : 'rgba(255,240,248,0.98)',
            bgGrad1  : dark ? 'rgba(212,181,232,0.08)'      : 'rgba(212,181,232,0.22)',
            bgGrad2  : dark ? 'rgba(245,201,212,0.08)'      : 'rgba(245,201,212,0.22)',
            platform : dark ? '#7a5a9e'                      : '#b48fd8',
            platGlow : dark ? 'rgba(180,143,216,0.35)'      : 'rgba(180,143,216,0.45)',
            player   : dark ? '#f5c9d4'                      : '#d4b5e8',
            playerGlow: dark ? 'rgba(245,201,212,0.7)'      : 'rgba(212,181,232,0.8)',
            scoreText: dark ? '#e0d0f0'                      : '#5a5a6e',
            overlayBg: dark ? 'rgba(30,20,45,0.88)'         : 'rgba(255,250,255,0.88)',
            overlayBorder: dark ? 'rgba(212,181,232,0.3)'   : 'rgba(180,143,216,0.4)',
            titleText: dark ? '#f0d8f8'                      : '#7a4a9e',
            bodyText : dark ? '#d4c0e8'                      : '#5a5a6e',
            btnBg    : 'linear-gradient(135deg,#d4b5e8,#f5c9d4)',
            btnText  : '#4a3060',
            floorLine: dark ? 'rgba(180,143,216,0.25)'      : 'rgba(180,143,216,0.3)',
            hintText : dark ? 'rgba(220,190,240,0.85)'      : 'rgba(180,143,216,0.85)',
        };
    }

    /* ── Game constants ── */
    const W = 800, H = 400;
    const GROUND_Y   = H - 60;   /* y of floor surface */
    const CEIL_Y     = 60;       /* y of ceiling surface */
    const PLAT_H     = 18;
    const PLAYER_W   = 28;
    const PLAYER_H   = 28;
    const GAP_MIN    = 90;
    const GAP_MAX    = 160;
    const PLAT_MIN   = 60;
    const PLAT_MAX   = 200;
    const GRAVITY    = 0.55;
    const JUMP_SPEED = -10;      /* velocity when gravity flips */
    const BASE_SPEED = 2.0;
    const GRACE_DURATION = 7;   /* seconds of safe runway at game start */
    const MAX_LIVES             = 3;
    const HIT_INVINCIBLE_FRAMES = 90;   /* ~1.5 s of invincibility after a hit */
    const ENEMY_SPAWN_INTERVAL  = 480;  /* frames between enemy spawns (~8 s) */
    const PROJ_SPEED            = 3.0;
    const PROJ_RADIUS           = 5;
    const PLAYER_HIT_RADIUS     = 9;   /* forgiving collision radius for projectile hits */

    /* ── Persistence ── */
    const LS_KEY = 'gravityFlip_highScore';

    function loadHighScore() {
        try {
            const saved = localStorage.getItem(LS_KEY);
            if (saved === null) return 0;
            const parsed = parseInt(saved, 10);
            return isNaN(parsed) || parsed < 0 ? 0 : parsed;
        } catch (e) {
            return 0;
        }
    }

    function saveHighScore(val) {
        try {
            localStorage.setItem(LS_KEY, String(val));
        } catch (e) { /* storage may be unavailable */ }
    }

    /* ── State ── */
    let state      = 'intro';   /* intro | playing | gameover */
    let score      = 0;
    let highScore  = loadHighScore();
    let newRecord  = false;     /* true when this run beat the stored best */
    let speed      = BASE_SPEED;
    let frameCount = 0;
    let gracePhase = false;     /* true during the safe runway at game start */
    let raf        = null;

    /* Player */
    let player = {};
    /* Platforms — two rows: floor (gravDir=1) and ceiling (gravDir=-1) */
    let platforms = [];
    /* Particles */
    let particles = [];
    /* Enemies and projectiles */
    let enemies     = [];
    let projectiles = [];
    /* Player health */
    let lives    = MAX_LIVES;
    let hitTimer = 0;   /* invincibility frames remaining after a hit */

    /* ── Helpers ── */
    function lerp(a, b, t) { return a + (b - a) * t; }

    function roundRect(cx, x, y, w, h, r) {
        cx.beginPath();
        cx.moveTo(x + r, y);
        cx.lineTo(x + w - r, y);
        cx.arcTo(x + w, y,     x + w, y + r,     r);
        cx.lineTo(x + w, y + h - r);
        cx.arcTo(x + w, y + h, x + w - r, y + h, r);
        cx.lineTo(x + r, y + h);
        cx.arcTo(x,     y + h, x,     y + h - r, r);
        cx.lineTo(x,     y + r);
        cx.arcTo(x,     y,     x + r, y,         r);
        cx.closePath();
    }

    /* ── Init / reset ── */
    function initGame() {
        score      = 0;
        speed      = BASE_SPEED;
        frameCount = 0;
        gracePhase  = true;
        particles   = [];
        enemies     = [];
        projectiles = [];
        lives       = MAX_LIVES;
        hitTimer    = 0;

        player = {
            x    : 120,
            y    : GROUND_Y - PLAYER_H,
            vy   : 0,
            grav : 1,          /* 1 = floor, -1 = ceiling */
            flip : false,      /* animating flip */
            flipT: 0,          /* flip animation timer */
            angle: 0,
        };

        /* Seed platforms so screen is already populated */
        platforms = [];
        seedPlatforms();
    }

    function seedPlatforms() {
        if (gracePhase) {
            /* Solid, gap-free surfaces covering the full visible area + buffer */
            platforms.push({ x: 0, y: GROUND_Y,          w: W + 600, side: 'floor' });
            platforms.push({ x: 0, y: CEIL_Y - PLAT_H,   w: W + 600, side: 'ceil'  });
            return;
        }
        /* Create floor platforms covering the visible area */
        let x = 0;
        while (x < W + 200) {
            const pw = rand(PLAT_MIN, PLAT_MAX);
            platforms.push({ x, y: GROUND_Y, w: pw, side: 'floor' });
            x += pw + rand(GAP_MIN, GAP_MAX);
        }
        /* Create ceiling platforms (offset so gaps don't always line up) */
        x = rand(100, 300);
        while (x < W + 200) {
            const pw = rand(PLAT_MIN, PLAT_MAX);
            platforms.push({ x, y: CEIL_Y - PLAT_H, w: pw, side: 'ceil' });
            x += pw + rand(GAP_MIN, GAP_MAX);
        }
    }

    function rand(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    /* ── Input ── */
    function flip() {
        if (state !== 'playing') return;
        player.grav  *= -1;
        player.vy     = JUMP_SPEED * player.grav;
        player.flip   = true;
        player.flipT  = 0;
        spawnFlipParticles();
    }

    document.addEventListener('keydown', function (e) {
        if (e.code === 'Space' || e.key === ' ') {
            e.preventDefault();
            if (state === 'intro' || state === 'gameover') {
                startGame();
            } else {
                flip();
            }
        }
    });

    canvas.addEventListener('pointerdown', function (e) {
        e.preventDefault();
        if (state === 'intro' || state === 'gameover') {
            startGame();
        } else {
            flip();
        }
    });

    function startGame() {
        initGame();
        state = 'playing';
        if (raf) cancelAnimationFrame(raf);
        raf = requestAnimationFrame(loop);
    }

    /* ── Particles ── */
    function spawnFlipParticles() {
        for (let i = 0; i < 12; i++) {
            particles.push({
                x  : player.x + PLAYER_W / 2,
                y  : player.y + PLAYER_H / 2,
                vx : (Math.random() - 0.5) * 5,
                vy : (Math.random() - 0.5) * 5,
                life: 1,
                decay: 0.04 + Math.random() * 0.04,
                r  : 2 + Math.random() * 3,
            });
        }
    }

    function updateParticles() {
        particles = particles.filter(function (p) {
            p.x   += p.vx;
            p.y   += p.vy;
            p.life -= p.decay;
            return p.life > 0;
        });
    }

    /* ── Platform generation ── */
    function getLastX(side) {
        let max = -Infinity;
        platforms.forEach(function (p) {
            if (p.side === side) max = Math.max(max, p.x + p.w);
        });
        return max;
    }

    function spawnMorePlatforms() {
        ['floor', 'ceil'].forEach(function (side) {
            while (getLastX(side) < W + 400) {
                const pw    = rand(PLAT_MIN, PLAT_MAX);
                const lastX = getLastX(side);
                const y     = side === 'floor' ? GROUND_Y : CEIL_Y - PLAT_H;
                /* No gap during grace phase — extend the surface seamlessly */
                const gx    = gracePhase ? 0 : rand(GAP_MIN, GAP_MAX);
                platforms.push({ x: lastX + gx, y, w: pw, side });
            }
        });
    }

    /* ── Update ── */
    function update() {
        frameCount++;
        score++;

        /* Grace phase: flip to normal gameplay after GRACE_DURATION seconds */
        if (gracePhase && frameCount / 60 >= GRACE_DURATION) {
            gracePhase = false;
        }

        /* Speed ramp — gentler than before */
        speed = BASE_SPEED + (frameCount / 900);

        /* Player physics */
        player.vy    += GRAVITY * player.grav;
        player.y     += player.vy;

        /* Flip animation */
        if (player.flip) {
            player.flipT += 0.15;
            player.angle  = player.flipT * Math.PI;
            if (player.flipT >= 1) {
                player.flip  = false;
                player.angle = 0;
            }
        }

        /* Platform collision */
        let onSurface = false;
        platforms.forEach(function (p) {
            if (player.x + PLAYER_W > p.x && player.x < p.x + p.w) {
                if (p.side === 'floor' && player.grav === 1) {
                    const bottom = GROUND_Y;
                    if (player.y + PLAYER_H >= bottom && player.vy >= 0) {
                        player.y  = bottom - PLAYER_H;
                        player.vy = 0;
                        onSurface = true;
                    }
                } else if (p.side === 'ceil' && player.grav === -1) {
                    const top = CEIL_Y;
                    if (player.y <= top && player.vy <= 0) {
                        player.y  = top;
                        player.vy = 0;
                        onSurface = true;
                    }
                }
            }
        });

        /* Scroll platforms */
        platforms.forEach(function (p) { p.x -= speed; });
        platforms = platforms.filter(function (p) { return p.x + p.w > -10; });
        spawnMorePlatforms();

        /* Hit timer (invincibility countdown after being struck) */
        if (hitTimer > 0) hitTimer--;

        /* Game over / respawn: player exits canvas vertically */
        if (player.y > H + 20 || player.y < -PLAYER_H - 20) {
            if (gracePhase) {
                /* Clamp the player back to a safe position during the grace phase */
                player.y  = player.grav === 1 ? GROUND_Y - PLAYER_H : CEIL_Y;
                player.vy = 0;
            } else {
                lives--;
                if (lives <= 0) {
                    endGame();
                    return;
                }
                /* Respawn on the floor with brief invincibility */
                player.y    = GROUND_Y - PLAYER_H;
                player.vy   = 0;
                player.grav = 1;
                hitTimer    = HIT_INVINCIBLE_FRAMES;
            }
        }

        /* Spawn enemies after grace phase (first one at ~15 s in) */
        if (!gracePhase && frameCount > 900 &&
                frameCount % ENEMY_SPAWN_INTERVAL === 0 && enemies.length < 2) {
            spawnEnemy();
        }

        updateParticles();
        updateEnemies();
        updateProjectiles();
    }

    function endGame() {
        if (score > highScore) {
            highScore = score;
            saveHighScore(highScore);
            newRecord = true;
        } else {
            newRecord = false;
        }
        state = 'gameover';
    }

    /* ── Draw helpers ── */
    function drawBackground(p) {
        const grad = ctx.createLinearGradient(0, 0, W, H);
        grad.addColorStop(0, p.bgGrad1);
        grad.addColorStop(1, p.bgGrad2);

        ctx.fillStyle = p.bg1;
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H);

        /* Subtle floor / ceiling lines */
        ctx.strokeStyle = p.floorLine;
        ctx.lineWidth   = 2;
        ctx.setLineDash([8, 6]);
        ctx.beginPath(); ctx.moveTo(0, GROUND_Y); ctx.lineTo(W, GROUND_Y); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, CEIL_Y);   ctx.lineTo(W, CEIL_Y);   ctx.stroke();
        ctx.setLineDash([]);
    }

    function drawPlatforms(p) {
        platforms.forEach(function (plt) {
            /* Glow */
            ctx.shadowColor = p.platGlow;
            ctx.shadowBlur  = 10;
            ctx.fillStyle   = p.platform;
            roundRect(ctx, plt.x, plt.y, plt.w, PLAT_H, 5);
            ctx.fill();
            ctx.shadowBlur  = 0;
        });
    }

    function drawPlayer(p) {
        /* Blink while invincible (not during game over freeze) */
        if (state === 'playing' && hitTimer > 0 && Math.floor(hitTimer / 5) % 2 === 1) return;

        const cx = player.x + PLAYER_W / 2;
        const cy = player.y + PLAYER_H / 2;

        ctx.save();
        ctx.translate(cx, cy);
        if (player.flip) {
            ctx.rotate(player.angle * player.grav);
        } else if (player.grav === -1) {
            ctx.scale(1, -1);   /* show puppy upside-down on the ceiling */
        }

        drawPuppy(p);

        ctx.restore();
    }

    /* ── Puppy drawing (local coords centred at 0,0) ── */
    function drawPuppy(p) {
        const t        = frameCount;
        const legSwing = Math.sin(t * 0.25) * 4;
        const tailWag  = Math.sin(t * 0.18) * 5;

        const fur     = '#c8956c';
        const darkFur = '#9a6040';
        const lite    = '#f0e0d0';

        /* ---- glow ---- */
        ctx.shadowColor = p.playerGlow;
        ctx.shadowBlur  = 14;

        /* ---- body ---- */
        ctx.fillStyle = fur;
        ctx.beginPath();
        ctx.ellipse(-2, 3, 12, 7, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.shadowBlur = 0;

        /* ---- tail (wagging at the back) ---- */
        ctx.strokeStyle = fur;
        ctx.lineWidth   = 3.5;
        ctx.lineCap     = 'round';
        ctx.beginPath();
        ctx.moveTo(-12, 1);
        ctx.quadraticCurveTo(-17 + tailWag, -6, -15 + tailWag * 0.6, -13);
        ctx.stroke();

        /* ---- legs — two pairs, alternating swing ---- */
        ctx.fillStyle = darkFur;
        roundRect(ctx,  3 + legSwing,  8, 4, 6, 2); ctx.fill();
        roundRect(ctx,  3 - legSwing,  8, 4, 6, 2); ctx.fill();
        roundRect(ctx, -9 - legSwing,  8, 4, 6, 2); ctx.fill();
        roundRect(ctx, -9 + legSwing,  8, 4, 6, 2); ctx.fill();

        /* ---- head ---- */
        ctx.shadowColor = p.playerGlow;
        ctx.shadowBlur  = 10;
        ctx.fillStyle   = fur;
        ctx.beginPath();
        ctx.arc(8, -2, 9, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;

        /* ---- floppy ears ---- */
        ctx.fillStyle = darkFur;
        ctx.beginPath();
        ctx.ellipse(2, -7, 4, 6, -0.3, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(13, -7, 4, 6, 0.3, 0, Math.PI * 2);
        ctx.fill();

        /* ---- snout ---- */
        ctx.fillStyle = lite;
        ctx.beginPath();
        ctx.ellipse(14, -1, 4.5, 3, 0, 0, Math.PI * 2);
        ctx.fill();

        /* ---- nose ---- */
        ctx.fillStyle = '#443322';
        ctx.beginPath();
        ctx.ellipse(15.5, -2.5, 2.2, 1.5, 0, 0, Math.PI * 2);
        ctx.fill();

        /* ---- eye ---- */
        ctx.fillStyle = '#222222';
        ctx.beginPath();
        ctx.arc(10, -5, 2.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.85)';
        ctx.beginPath();
        ctx.arc(11, -6, 0.9, 0, Math.PI * 2);
        ctx.fill();

        /* ---- tongue (panting, bobs periodically) ---- */
        if (Math.sin(t * 0.07) > 0.2) {
            ctx.fillStyle = '#ff7090';
            ctx.beginPath();
            ctx.ellipse(15.5, 1.5, 2, 2.5, 0.2, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    function drawParticles(p) {
        particles.forEach(function (pt) {
            ctx.globalAlpha = pt.life;
            ctx.fillStyle   = p.player;
            ctx.beginPath();
            ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
            ctx.fill();
        });
        ctx.globalAlpha = 1;
    }

    /* ── Enemy: mean flying cat ── */
    function spawnEnemy() {
        const yMin = CEIL_Y + 30;
        const yMax = GROUND_Y - 30;
        enemies.push({
            x         : W + 30,
            y         : yMin + Math.random() * (yMax - yMin),
            vx        : -0.8,
            shotTimer : 80,    /* first shot after ~1.3 s */
            shotsLeft : 4,
            retreating: false,
        });
    }

    function spawnProjectile(en) {
        const tx = player.x + PLAYER_W / 2;
        const ty = player.y + PLAYER_H / 2;
        const dx = tx - en.x;
        const dy = ty - en.y;
        const d  = Math.sqrt(dx * dx + dy * dy) || 1;
        projectiles.push({
            x  : en.x,
            y  : en.y,
            vx : (dx / d) * PROJ_SPEED,
            vy : (dy / d) * PROJ_SPEED,
        });
    }

    function updateEnemies() {
        enemies.forEach(function (en) {
            if (en.retreating) {
                en.x += 2.5;
            } else {
                en.x += en.vx;
                en.shotTimer--;
                if (en.shotTimer <= 0 && en.shotsLeft > 0) {
                    spawnProjectile(en);
                    en.shotsLeft--;
                    en.shotTimer = 90;
                    if (en.shotsLeft <= 0) en.retreating = true;
                }
            }
        });
        enemies = enemies.filter(function (en) {
            return en.x > -60 && en.x < W + 120;
        });
    }

    function updateProjectiles() {
        projectiles.forEach(function (proj) {
            proj.x += proj.vx;
            proj.y += proj.vy;
            /* Collision with player (skip while invincible or game over) */
            if (hitTimer <= 0 && state === 'playing') {
                const dx   = proj.x - (player.x + PLAYER_W / 2);
                const dy   = proj.y - (player.y + PLAYER_H / 2);
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < PROJ_RADIUS + PLAYER_HIT_RADIUS) {
                    proj.active = false;
                    lives--;
                    hitTimer = HIT_INVINCIBLE_FRAMES;
                    if (lives <= 0) endGame();
                }
            }
        });
        projectiles = projectiles.filter(function (proj) {
            return proj.active !== false &&
                   proj.x > -20 && proj.x < W + 20 &&
                   proj.y > -20 && proj.y < H + 20;
        });
    }

    function drawEnemies(p) {
        enemies.forEach(function (en) { drawEnemy(en); });
    }

    function drawEnemy(en) {
        const t   = frameCount * 0.08;
        const hov = Math.sin(t) * 4;

        ctx.save();
        ctx.translate(en.x, en.y + hov);

        /* Body */
        ctx.shadowColor = 'rgba(230,80,50,0.55)';
        ctx.shadowBlur  = 12;
        ctx.fillStyle   = '#e05030';
        ctx.beginPath();
        ctx.ellipse(0, 2, 13, 10, 0, 0, Math.PI * 2);
        ctx.fill();

        /* Head */
        ctx.fillStyle = '#e05030';
        ctx.beginPath();
        ctx.arc(-1, -8, 10, 0, Math.PI * 2);
        ctx.fill();

        ctx.shadowBlur = 0;

        /* Pointy ears */
        ctx.fillStyle = '#c03020';
        ctx.beginPath(); ctx.moveTo(-9, -14); ctx.lineTo(-6, -22); ctx.lineTo(-3, -14); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo( 3, -14); ctx.lineTo( 6, -22); ctx.lineTo( 9, -14); ctx.closePath(); ctx.fill();

        /* Inner ear */
        ctx.fillStyle = '#ffb0a0';
        ctx.beginPath(); ctx.moveTo(-8, -15); ctx.lineTo(-6, -20); ctx.lineTo(-4, -15); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo( 4, -15); ctx.lineTo( 6, -20); ctx.lineTo( 8, -15); ctx.closePath(); ctx.fill();

        /* Eyes (angry yellow) */
        ctx.fillStyle = '#ffee00';
        ctx.beginPath(); ctx.ellipse(-4, -9, 3.5, 2.5, -0.25, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.ellipse( 4, -9, 3.5, 2.5,  0.25, 0, Math.PI * 2); ctx.fill();

        /* Pupils (cat slits) */
        ctx.fillStyle = '#111';
        ctx.beginPath(); ctx.ellipse(-4, -9, 1.1, 2.2, 0, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.ellipse( 4, -9, 1.1, 2.2, 0, 0, Math.PI * 2); ctx.fill();

        /* Angry eyebrows */
        ctx.strokeStyle = '#ff9966';
        ctx.lineWidth   = 2;
        ctx.beginPath(); ctx.moveTo(-7.5, -13); ctx.lineTo(-1.5, -12); ctx.stroke();
        ctx.beginPath(); ctx.moveTo( 7.5, -13); ctx.lineTo( 1.5, -12); ctx.stroke();

        /* Whiskers */
        ctx.strokeStyle = 'rgba(255,220,180,0.85)';
        ctx.lineWidth   = 1;
        ctx.beginPath(); ctx.moveTo(-1, -6); ctx.lineTo(-14, -4); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(-1, -5); ctx.lineTo(-14, -7); ctx.stroke();
        ctx.beginPath(); ctx.moveTo( 1, -6); ctx.lineTo( 14, -4); ctx.stroke();
        ctx.beginPath(); ctx.moveTo( 1, -5); ctx.lineTo( 14, -7); ctx.stroke();

        /* Frowning mouth */
        ctx.strokeStyle = '#ff9966';
        ctx.lineWidth   = 1.5;
        ctx.beginPath();
        ctx.arc(0, -3, 5, 0.3, Math.PI - 0.3);
        ctx.stroke();

        ctx.restore();
    }

    function drawProjectiles(p) {
        projectiles.forEach(function (proj) {
            ctx.save();
            ctx.translate(proj.x, proj.y);

            ctx.shadowColor = 'rgba(255,140,0,0.9)';
            ctx.shadowBlur  = 8;
            ctx.fillStyle   = '#ff6600';
            ctx.beginPath();
            ctx.arc(0, 0, PROJ_RADIUS, 0, Math.PI * 2);
            ctx.fill();

            ctx.shadowBlur = 0;
            ctx.fillStyle  = '#ffdd44';
            ctx.beginPath();
            ctx.arc(-1, -1, PROJ_RADIUS * 0.45, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        });
    }

    function drawHUD(p) {
        ctx.fillStyle   = p.scoreText;
        ctx.font        = "bold 16px 'Lato', sans-serif";
        ctx.textAlign   = 'left';
        ctx.fillText('Score: ' + Math.floor(score / 6), 16, 28);
        ctx.textAlign   = 'right';
        ctx.fillText('Best: ' + Math.floor(highScore / 6), W - 16, 28);

        /* Lives (hearts) centred at top */
        const hSpacing = 24;
        const hStartX  = W / 2 - (MAX_LIVES - 1) * hSpacing / 2;
        ctx.font      = '18px sans-serif';
        ctx.textAlign = 'center';
        for (let i = 0; i < MAX_LIVES; i++) {
            ctx.fillStyle = i < lives ? '#ff6b8a' : 'rgba(255,107,138,0.25)';
            ctx.fillText('\u2665', hStartX + i * hSpacing, 28);
        }
        ctx.textAlign = 'left';
    }

    /* ── Overlay card ── */
    function drawOverlayCard(p, lines) {
        const cardW = 480, cardH = lines.length * 42 + 60;
        const cx = W / 2, cy = H / 2;
        const x  = cx - cardW / 2, y = cy - cardH / 2;

        /* Backdrop blur simulation */
        ctx.fillStyle = p.overlayBg;
        roundRect(ctx, x, y, cardW, cardH, 18);
        ctx.fill();

        ctx.strokeStyle = p.overlayBorder;
        ctx.lineWidth   = 1.5;
        roundRect(ctx, x, y, cardW, cardH, 18);
        ctx.stroke();

        ctx.textAlign = 'center';
        lines.forEach(function (line, i) {
            ctx.font      = line.font || "16px 'Lato', sans-serif";
            ctx.fillStyle = line.color || p.bodyText;
            ctx.fillText(line.text, cx, y + 50 + i * 42);
        });
        ctx.textAlign = 'left';
    }

    /* ── Try Again button ── */
    const BTN = { x: 0, y: 0, w: 160, h: 42 };

    function drawTryAgainBtn(p, cardLines) {
        BTN.x = W / 2 - BTN.w / 2;
        const cardH = (cardLines || 3) * 42 + 60;
        BTN.y = Math.min(H / 2 + cardH / 2 + 10, H - BTN.h - 10);

        const grad = ctx.createLinearGradient(BTN.x, BTN.y, BTN.x + BTN.w, BTN.y);
        grad.addColorStop(0, '#d4b5e8');
        grad.addColorStop(1, '#f5c9d4');

        ctx.shadowColor = 'rgba(180,143,216,0.4)';
        ctx.shadowBlur  = 12;
        ctx.fillStyle   = grad;
        roundRect(ctx, BTN.x, BTN.y, BTN.w, BTN.h, 12);
        ctx.fill();
        ctx.shadowBlur  = 0;

        ctx.fillStyle = p.btnText;
        ctx.font      = "bold 15px 'Lato', sans-serif";
        ctx.textAlign = 'center';
        ctx.fillText('Try Again', W / 2, BTN.y + 28);
        ctx.textAlign = 'left';
    }

    /* ── Draw scenes ── */
    function drawIntro(p) {
        drawBackground(p);

        const lines = [
            { text: '🌸 Gravity Flip Platformer', font: "bold 24px 'Playfair Display', serif", color: p.titleText },
            { text: "You've made it this far in the interview —", font: "italic 14px 'Lato', sans-serif", color: p.bodyText },
            { text: 'can you survive the gravity flip?', font: "italic 14px 'Lato', sans-serif", color: p.bodyText },
            { text: 'Press Space / Tap to flip gravity', font: "14px 'Lato', sans-serif", color: p.bodyText },
            { text: 'Avoid gaps & enemy fireballs \u2014 you have \u2665\u2665\u2665 three lives! \uD83D\uDC36', font: "14px 'Lato', sans-serif", color: p.bodyText },
        ];
        if (highScore > 0) {
            lines.push({ text: 'Your Best: ' + Math.floor(highScore / 6), font: "14px 'Lato', sans-serif", color: '#b48fd8' });
        }
        drawOverlayCard(p, lines);

        /* Start button — positioned just below the card */
        const bw = 160, bh = 42;
        const cardH = lines.length * 42 + 60;
        const bx = W / 2 - bw / 2;
        const by = Math.min(H / 2 + cardH / 2 + 10, H - bh - 10);
        const grad = ctx.createLinearGradient(bx, by, bx + bw, by);
        grad.addColorStop(0, '#d4b5e8');
        grad.addColorStop(1, '#f5c9d4');
        ctx.fillStyle = grad;
        roundRect(ctx, bx, by, bw, bh, 12);
        ctx.fill();
        ctx.fillStyle = p.btnText;
        ctx.font      = "bold 15px 'Lato', sans-serif";
        ctx.textAlign = 'center';
        ctx.fillText('Start Game', W / 2, by + 28);
        ctx.textAlign = 'left';
    }

    function drawPlaying(p) {
        drawBackground(p);
        drawPlatforms(p);
        drawEnemies(p);
        drawParticles(p);
        drawPlayer(p);
        drawProjectiles(p);
        drawHUD(p);
        if (gracePhase) { drawGraceHint(p); }
    }

    /* ── Grace-phase hint ── */
    function drawGraceHint(p) {
        const elapsed   = frameCount / 60;
        const fadeStart = GRACE_DURATION - 1;
        const alpha     = elapsed > fadeStart
            ? Math.max(0, 1 - (elapsed - fadeStart))
            : 1;

        ctx.globalAlpha = alpha;
        ctx.fillStyle   = p.hintText;
        ctx.font        = "13px 'Lato', sans-serif";
        ctx.textAlign   = 'center';
        ctx.fillText('Get ready… gaps start soon! \uD83C\uDF38', W / 2, 50);
        ctx.textAlign   = 'left';
        ctx.globalAlpha = 1;
    }

    function drawGameOver(p) {
        drawBackground(p);
        drawPlatforms(p);
        drawEnemies(p);
        drawParticles(p);
        drawPlayer(p);
        drawProjectiles(p);

        /* Dim overlay */
        ctx.fillStyle = 'rgba(0,0,0,0.25)';
        ctx.fillRect(0, 0, W, H);

        const lines = [
            { text: 'Game Over 💔', font: "bold 26px 'Playfair Display', serif", color: p.titleText },
            { text: 'Score: ' + Math.floor(score / 6), font: "18px 'Lato', sans-serif", color: p.bodyText },
            { text: 'Best: ' + Math.floor(highScore / 6), font: "16px 'Lato', sans-serif", color: p.bodyText },
        ];
        if (newRecord) {
            lines.push({ text: '🏆 New Best — saved!', font: "bold 15px 'Lato', sans-serif", color: '#b48fd8' });
        }
        drawOverlayCard(p, lines);

        drawTryAgainBtn(p, lines.length);
    }

    /* ── Main loop ── */
    function loop() {
        const p = palette();

        if (state === 'playing') {
            update();
        }

        if (state === 'intro') {
            drawIntro(p);
        } else if (state === 'playing') {
            drawPlaying(p);
        } else if (state === 'gameover') {
            drawGameOver(p);
        }

        raf = requestAnimationFrame(loop);
    }

    /* ── Bootstrap ── */
    initGame();
    raf = requestAnimationFrame(loop);
}());
</script>
